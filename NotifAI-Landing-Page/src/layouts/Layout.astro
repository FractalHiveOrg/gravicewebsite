---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import BookDemoModal from "../components/BookDemoModal.astro";
import "../styles/global.css";

interface Props {
  /** Page title – appears in <title> and OG/Twitter tags */
  title?: string;
  /** Meta description (150–160 chars) */
  description?: string;
  /** Absolute canonical URL. Defaults to current page URL. */
  canonical?: string;
  /** Absolute URL to OG image (1200×630 recommended) */
  ogImage?: string;
  /** Page type for Open Graph */
  ogType?: "website" | "article";
  /** JSON-LD structured data object(s) */
  schema?: object | object[];
}

const {
  title = "Nico — Make your business autonomous",
  description = "Nico reads invoices, orders and requests, applies your rules, routes approvals to the right person and posts the result to your ERP. Start free.",
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = new URL("/og-image.png", Astro.site).href,
  ogType = "website",
  schema,
} = Astro.props;

// Default Organisation + WebSite schema always present on every page
const defaultSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Nico",
    url: Astro.site?.href ?? "https://nico.fractalhive.com",
    logo: new URL("/favicon.svg", Astro.site).href,
    description: description,
    sameAs: [],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Nico",
    url: Astro.site?.href ?? "https://nico.fractalhive.com",
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${Astro.site?.href ?? "https://nico.fractalhive.com"}?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  },
];

const gaMeasurementId = import.meta.env.VITE_PUBLIC_GA_MEASUREMENT_ID;

const allSchemas = schema
  ? [...defaultSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : defaultSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- ── Primary SEO ─────────────────────────────────── -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <!-- ── Favicons ────────────────────────────────────── -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- ── Open Graph ──────────────────────────────────── -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Nico" />
    <meta property="og:locale" content="en_US" />

    <!-- ── Twitter / X Card ────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- ── Performance hints ───────────────────────────── -->
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="/fonts/SFRounded-Semibold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- ── JSON-LD Structured Data ─────────────────────── -->
    {
      allSchemas.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }

    <!-- ── Google Analytics (gtag.js) ──────────────────── -->
    {
      gaMeasurementId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
          />
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag("js", new Date());

            gtag("config", gaMeasurementId);
          </script>
        </>
      )
    }

    <!-- ── Astro Client Router (View Transitions) ──── -->
    <ClientRouter />
  </head>
  <body class="bg-[#F6F3F1] text-slate-900">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Navbar transition:persist />
    <main id="main-content" tabindex="-1" class="outline-none">
      <div id="smooth-wrapper" class="w-full">
        <div id="smooth-content" class="w-full section-bg">
          <slot />
        </div>
      </div>
    </main>
    <BookDemoModal />

    <!-- ── Microsoft Clarity analytics ─────────────────── -->
    <script>
      import Clarity from "@microsoft/clarity";

      const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID 
      if (clarityId) {
        Clarity.init(clarityId);
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background-color: #F6F3F1;
  }

  .skip-link {
    position: absolute;
    top: -9999px;
    left: 16px;
    z-index: 9999;
    background-color: #1e3a5f;
    color: #ffffff;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    transition: top 0.2s ease-in-out;
  }

  .skip-link:focus {
    top: 16px;
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }
</style>

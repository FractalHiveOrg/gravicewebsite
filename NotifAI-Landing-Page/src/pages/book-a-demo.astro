---
// book-a-demo.astro - Dedicated Book a Demo page with Cal.com scheduler
import Layout from "../layouts/Layout.astro";
import FooterSection from "../components/FooterSection.astro";
---

<Layout
  title="Book a Demo — Nico | Autonomous Business Process Automation"
  description="Book a 15-minute walkthrough with the Nico team. Bring a process you run today and see how Nico handles it, from incoming documents to your ERP."
  canonical="https://nico.fractalhive.com/book-a-demo"
>
  <div class="w-full min-h-screen pt-24 sm:pt-28 md:pt-32 pb-16 px-4 sm:px-6 lg:px-8  ">
    <div class="max-w-5xl mx-auto flex flex-col items-center">
      
      <!-- Top Eyebrow -->
     

      <!-- Main Heading -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-normal text-slate-900 tracking-tight leading-[1.12] text-center font-demo-serif mb-4 sm:mb-5">
        See Nico in action.
      </h1>

      <!-- Subtitle -->
      <p class="text-sm sm:text-base md:text-lg text-slate-600 max-w-2xl mx-auto text-center leading-relaxed mb-8 sm:mb-10 font-normal text-balance">
        15 minutes with our team, <br class="hidden sm:inline" />
        using a process you run today.
      </p>
      <!-- Cal.com Card Container -->
      <div class="w-full bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-xl overflow-hidden  relative">
        <div
          id="my-cal-inline-nico-demo"
          class="w-full min-h-[680px] sm:min-h-[720px] overflow-y-auto relative z-10"
          style="width:100%;height:100%;min-height:680px;overflow:scroll"
        ></div>
      </div>

    </div>
  </div>

  <FooterSection showCta={false} animate={false} />
</Layout>

<script type="text/javascript" is:inline>
  // Cal inline embed initialization for dedicated page
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "nico-demo", { origin: "https://app.cal.com" });
  Cal.config = Cal.config || {};
  Cal.config.forwardQueryParams = true;

  function initCalInlinePage() {
    var container = document.getElementById("my-cal-inline-nico-demo");
    if (!container) return;
    if (window._calInlinePageInitialized) return;
    window._calInlinePageInitialized = true;

    try {
      Cal.ns["nico-demo"]("inline", {
        elementOrSelector: "#my-cal-inline-nico-demo",
        config: { layout: "month_view", useSlotsViewOnSmallScreen: "true", theme: "light" },
        calLink: "gravice-nv1yfi/nico-demo?theme=light",
      });
      Cal.ns["nico-demo"]("ui", {
        theme: "light",
        hideEventTypeDetails: false,
        layout: "month_view",
        cssVarsPerTheme: { light: { "cal-brand": "#174771" } },
      });
    } catch (e) {
      console.error("Cal inline page init error:", e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCalInlinePage);
  } else {
    initCalInlinePage();
  }
  document.addEventListener("astro:page-load", function () {
    window._calInlinePageInitialized = false;
    initCalInlinePage();
  });
</script>

<style>
  .font-demo-serif {
    font-family: "Newsreader", "Times New Roman", Times, serif;
    letter-spacing: -0.02em;
  }


  .canvas-dot-grid {
    background-color: #faf9f6;
    background-image: radial-gradient(rgba(100, 116, 139, 0.22) 1.2px, transparent 1.2px);
    background-size: 18px 18px;
  }
</style>

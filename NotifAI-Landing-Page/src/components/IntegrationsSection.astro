---
// IntegrationsSection.astro - Native Integrations & Connectors Section
import IntegrationsHeader from "./integrations/IntegrationsHeader.astro";
const desktopVideoSrc = "https://fractalhiveassets.blob.core.windows.net/assets/AP_Animation-Desktop.mp4?sp=r&st=2026-10-08T05:10:26Z&se=2036-10-07T13:25:26Z&spr=https&sv=2026-02-06&sr=b&sig=Jyt%2BfB699k%2BezoMN77AKTCGnmotf1LJsxaltgMDR7zI%3D";
const mobileVideoSrc = "https://fractalhiveassets.blob.core.windows.net/assets/AP_Animation-Mobile.mp4?sp=r&st=2026-10-08T05:14:51Z&se=2036-10-07T13:29:51Z&spr=https&sv=2026-02-06&sr=b&sig=18PfDfT27UzpuoOjIDUoQmC%2FpoCbD2P%2B8Bfwub%2FbVX4%3D";
---

<section
  id="integrations-section"
  class="w-full sm:min-h-screen lg:h-screen lg:max-h-screen sm:py-12 lg:py-6 px-4 py-14 sm:px-6 lg:px-8 flex flex-col items-center justify-center relative overflow-hidden"
>
  <div class="w-full max-w-310 mx-auto flex flex-col h-full max-h-full justify-center">
    <!-- ================= SECTION HEADER ================= -->
    <div class="shrink-0 w-full">
      <IntegrationsHeader />
    </div>

    <!-- ================= MAIN VISUAL / CONNECTOR DIAGRAM ================= -->
    <div class="w-full flex-1 min-h-0 flex items-center justify-center relative">
      <div class="relative z-10 w-full h-full flex items-center justify-center">
        <!-- Video Loading Spinner -->
        <div
          id="integrations-video-loader"
          class="absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-300 z-20 opacity-0"
          aria-hidden="true"
        >
          <div class="flex flex-col items-center gap-3">
            <div class="w-10 h-10 rounded-full border-3 border-slate-300 border-t-[#1E3A5F] animate-spin"></div>
            <span class="text-xs font-medium text-slate-500 tracking-wide select-none">Loading video...</span>
          </div>
        </div>

        <video
          id="integrations-video"
          data-desktop-src={desktopVideoSrc}
          data-mobile-src={mobileVideoSrc}
          loop
          muted
          playsinline
          preload="none"
          class="w-auto h-auto max-w-full max-h-[68vh] lg:max-h-full object-contain border-0"
        ></video>
      </div>
    </div>
  </div>
</section>

<script>
  let cleanupIntegrationsVideo: (() => void) | null = null;

  function initIntegrationsVideo() {
    // ClientRouter swaps the DOM on navigation, so tear down listeners bound to the previous page
    cleanupIntegrationsVideo?.();
    cleanupIntegrationsVideo = null;

    const video = document.getElementById("integrations-video") as HTMLVideoElement | null;
    const section = document.getElementById("integrations-section");
    const loader = document.getElementById("integrations-video-loader");
    if (!video || !section) return;

    function showLoader() {
      if (loader) {
        loader.classList.remove("opacity-0");
        loader.classList.add("opacity-100");
      }
    }

    function hideLoader() {
      if (loader) {
        loader.classList.remove("opacity-100");
        loader.classList.add("opacity-0");
      }
    }

    function playVideo() {
      video!.play()?.catch(() => {});
    }

    video.addEventListener("waiting", showLoader);
    video.addEventListener("loadstart", () => {
      if (video.readyState < 3) showLoader();
    });
    video.addEventListener("canplay", hideLoader);
    video.addEventListener("playing", hideLoader);
    video.addEventListener("loadeddata", () => {
      if (video.readyState >= 3) hideLoader();
    });

    const desktopSrc = video.dataset.desktopSrc || "";
    const mobileSrc = video.dataset.mobileSrc || "";
    const mql = window.matchMedia("(max-width: 768px)");
    let isSectionVisible = false;

    function updateVideoSource() {
      const targetSrc = mql.matches ? mobileSrc : desktopSrc;
      if (!targetSrc) return;

      if (video!.getAttribute("src") !== targetSrc) {
        showLoader();
        video!.src = targetSrc;
        video!.load();
        if (isSectionVisible) playVideo();
      }
    }

    // Only load & play video when section is near or inside the viewport
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;
        isSectionVisible = entry.isIntersecting;

        if (isSectionVisible) {
          if (!video.getAttribute("src")) {
            updateVideoSource();
          } else {
            playVideo();
          }
        } else if (!video.paused) {
          video.pause();
        }
      },
      { rootMargin: "150px 0px" }
    );

    observer.observe(section);
    mql.addEventListener("change", updateVideoSource);

    cleanupIntegrationsVideo = () => {
      observer.disconnect();
      mql.removeEventListener("change", updateVideoSource);
      video.pause();
    };
  }

  document.addEventListener("astro:page-load", initIntegrationsVideo);
  document.addEventListener("astro:before-swap", () => {
    cleanupIntegrationsVideo?.();
    cleanupIntegrationsVideo = null;
  });
</script>

<style>
  #integrations-video {
    /* Cuts 1% off the edges and rounds the corners */
    clip-path: inset(1% 1% 1% 1% round 1rem);
  }
</style>

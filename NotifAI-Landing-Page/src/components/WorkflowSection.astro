    background-size: 36px 36px;
  }

  /* Fading Gradient Live Sticks */
  .wf-gradient-stick-v {
    position: absolute;
    left: calc(50% - 1px);
    top: 0;
    width: 2px;
    height: 18px;
    background: linear-gradient(
      to bottom,

      rgba(30, 58, 95, 0.7) 70%,
      #1e3a5f 100%
    );
    border-radius: 0 0 1.5px 1.5px;
    pointer-events: none;
    filter: drop-shadow(0 2px 2.5px rgba(30, 58, 95, 0.4));
    animation: live-gradient-stick-v 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .wf-glow-stick-v-delay-1 {
    animation-delay: 0.25s;
  }

  .wf-glow-stick-v-delay-2 {
    animation-delay: 0.5s;
  }

  @keyframes live-gradient-stick-v {
    0% {
      transform: translateY(-18px);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateY(24px);
      opacity: 0;
    }
  }

  .wf-gradient-stick-h {
    position: absolute;
    top: calc(50% - 1px);
    left: 0;
    height: 2px;
    width: 22px;
    background: linear-gradient(
      to right,
      rgba(30, 58, 95, 0) 0%,
      rgba(30, 58, 95, 0.25) 30%,
      rgba(30, 58, 95, 0.7) 70%,
      #1e3a5f 100%
    );
    border-radius: 0 1.5px 1.5px 0;
    pointer-events: none;
    filter: drop-shadow(2px 0 2.5px rgba(30, 58, 95, 0.4));
    opacity: 0;
  }

  /* Fork Fading Gradient Live Sticks */
  .wf-fork-head {
    stroke-width: 2.5;
    opacity: 1;
    filter: drop-shadow(0 0 2px rgba(30, 58, 95, 0.45));
  }

  .wf-fork-body {
    stroke-width: 2.1;
    opacity: 0.45;
  }

  .wf-fork-tail {
    stroke-width: 1.7;
    opacity: 0.18;
  }

  /* Active badge highlight during active pulse flow */
  .wf-badge-active {
    background-color: #1e3a5f !important;
    border-color: #1e3a5f !important;
    color: #ffffff !important;
    box-shadow: 0 0 10px rgba(30, 58, 95, 0.35) !important;
    transform: scale(1.12);
  }

  /* Status checkmark and review badges */
  .wf-check-badge,
  .wf-review-badge {
    pointer-events: none;
    transform-origin: center;
    will-change: transform, opacity;
  }

  /* Workflow step badges scaling & transform smoothness */
  [data-wf-step] > span.primary-bg-color,
  [data-wf-node] > span.primary-bg-color {
    display: inline-block;
    transform-origin: center bottom;
    will-change: transform, box-shadow;
    position: relative;
    z-index: 15;
  }

  /* Workflow cards transform smoothness */
  [data-wf-step],
  [data-wf-node] {
    transform-origin: center center;
    position: relative;
  }

  /* ─── Mobile: remove expensive filter:drop-shadow from animated elements ── */
  @media (max-width: 1023px) {
    .wf-gradient-stick-v,

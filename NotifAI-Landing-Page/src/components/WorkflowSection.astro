---
// WorkflowSection.astro - Nico Workflow Orchestration Section
---

<section
  id="workflow-section"
  class="w-full py-16 sm:py-20 lg:py-12 px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center relative min-h-screen overflow-x-hidden"
>
  <div class="w-full max-w-6xl mx-auto flex flex-col items-center">
    <!-- Top Eyebrow -->
    <p
      class="text-xs sm:text-[13px] font-bold tracking-[0.2em] uppercase text-slate-500 text-center mb-3"
    >
      HOW NICO WORKS
    </p>

    <!-- Main Heading -->
    <h2
      class="text-3xl sm:text-4xl md:text-5xl lg:text-[56px] font-normal text-slate-900 tracking-tight leading-[1.12] text-center font-workflow-serif mb-4"
    >
      From event to outcome.
    </h2>

    <!-- Subtitle -->
    <p
      class="text-sm sm:text-base md:text-lg text-slate-600 max-w-2xl mx-auto text-center leading-relaxed mb-12 sm:mb-16 font-normal text-balance"
    >
      Watch one invoice go from inbox to posted, <br class="hidden sm:inline" />
      with an optional check at every step.
    </p>

    <!-- Pinned Workflow Container (Canvas Card + Footnote) -->
    <div id="workflow-canvas-card" class="w-full flex flex-col items-center">
      <!-- Workflow Diagram Canvas Card -->
      <div
        class="w-full bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-[0_4px_30px_rgba(0,0,0,0.04)] relative overflow-hidden"
      >
        <div
          class="w-full max-w-full overflow-hidden flex flex-col relative canvas-grid rounded-xl py-6 px-3 sm:px-6 pb-10"
        >
          <!-- Canvas Top Bar -->
          <div class="flex items-center gap-3 mb-8">
            <span class="text-xs font-semibold text-slate-700 select-none">
              Nico Orchestration
            </span>
            <span
              class="text-[11px] font-medium text-slate-600 bg-white border border-slate-300 rounded px-2.5 py-0.5 shadow-2xs select-none"
            >
              Invoice Processing
            </span>
          </div>

          <!-- Flowchart Body -->
          <div class="w-full flex flex-col items-center relative">
            <div class="w-full ml-0 lg:-ml-100 flex flex-col items-center">
              <!-- ================= STEP 1: EVENT ================= -->
              <div
                class="w-fit flex flex-col items-center z-10"
                data-wf-step="1"
              >
                <!-- Dark Badge -->
                <span
                  class="primary-bg-color text-white text-[9px] font-bold tracking-widest uppercase px-2.5 py-0.5 rounded-t-xl shadow-2xs"
                >
                  EVENT
                </span>
                <!-- Card -->
                <div
                  class="bg-white border border-slate-200 rounded-xl shadow-[0_2px_10px_rgba(0,0,0,0.04)] px-3.5 py-2.5 flex items-center justify-between w-68 text-left hover:border-slate-300 hover:shadow-md transition-all"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div
                      class="w-8 h-8 rounded-lg border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-600 shrink-0"
                    >
                      <!-- Mail Icon -->
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.6"
                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path>
                      </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                      <span
                        class="text-xs font-semibold text-slate-900 leading-tight"
                      >
                        Invoice received via email
                      </span>
                      <span
                        class="text-[11px] text-slate-500 leading-tight mt-0.5"
                      >
                        Gmail Inbox · Supplier
                      </span>
                    </div>
                  </div>
                  <!-- Green Completed Check Badge -->
                  <div
                    class="wf-check-badge flex items-center justify-center shrink-0 ml-2"
                    data-wf-check="1"
                  >
                    <span
                      class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-xs"
                      title="Completed"
                    >
                      <svg
                        class="w-3 h-3 stroke-[2.5]"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"
                        ></path>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Connector Line 1 -->
              <div class="flex justify-center my-1 sm:my-1.5" data-wf-conn="1">
                <div
                  class="w-3 h-6 flex justify-center relative overflow-hidden"
                  data-wf-line
                >
                  <svg
                    class="w-3 h-6 overflow-visible"
                    viewBox="0 0 12 24"
                    fill="none"
                  >
                    <!-- Base Dashed Track -->
                    <line
                      x1="6"
                      y1="0"
                      x2="6"
                      y2="24"
                      stroke="#CBD5E1"
                      stroke-width="1.5"
                      stroke-dasharray="3 3"></line>
                  </svg>
                  <!-- Fading Gradient Live Stick -->
                  <div class="wf-gradient-stick-v" data-wf-pulse="1"></div>
                </div>
              </div>

              <!-- ================= STEP 2: NICO INTELLIGENCE ================= -->
              <div class="flex flex-col items-center z-10" data-wf-step="2">
                <!-- Dark Badge -->
                <span
                  class="primary-bg-color text-white text-[9px] font-bold tracking-widest uppercase px-2.5 py-0.5 rounded-t-xl shadow-2xs"
                >
                  NICO INTELLIGENCE
                </span>
                <!-- Card -->
                <div
                  class="bg-white border border-slate-200 rounded-xl shadow-[0_2px_10px_rgba(0,0,0,0.04)] px-3.5 py-2.5 flex items-center justify-between w-68 text-left hover:border-slate-300 hover:shadow-md transition-all"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div
                      class="w-8 h-8 rounded-lg border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-600 shrink-0"
                    >
                      <!-- Sparkle / AI Star Icon -->
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.6"
                          d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.286L13 21l-2.286-6.857L5 12l5.714-2.286L13 3z"
                        ></path>
                      </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                      <span
                        class="text-xs font-semibold text-slate-900 leading-tight"
                      >
                        Comprehend invoice
                      </span>
                      <span
                        class="text-[11px] text-slate-500 leading-tight mt-0.5"
                      >
                        Extract fields · Classify document type
                      </span>
                    </div>
                  </div>
                  <!-- Green Completed Check Badge -->
                  <div
                    class="wf-check-badge flex items-center justify-center shrink-0 ml-2"
                    data-wf-check="2"
                  >
                    <span
                      class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-xs"
                      title="Completed"
                    >
                      <svg
                        class="w-3 h-3 stroke-[2.5]"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"
                        ></path>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Connector Line 2 -->
              <div class="flex justify-center my-1 sm:my-1.5" data-wf-conn="2">
                <div
                  class="w-3 h-6 flex justify-center relative overflow-hidden"
                  data-wf-line
                >
                  <svg
                    class="w-3 h-6 overflow-visible"
                    viewBox="0 0 12 24"
                    fill="none"
                  >
                    <!-- Base Dashed Track -->
                    <line
                      x1="6"
                      y1="0"
                      x2="6"
                      y2="24"
                      stroke="#CBD5E1"
                      stroke-width="1.5"
                      stroke-dasharray="3 3"></line>
                  </svg>
                  <!-- Fading Gradient Live Stick -->
                  <div
                    class="wf-gradient-stick-v wf-glow-stick-v-delay-1"
                    data-wf-pulse="2"
                  >
                  </div>
                </div>
              </div>

              <!-- ================= STEP 3: VALIDATIONS ================= -->
              <div class="flex flex-col items-center z-10" data-wf-step="3">
                <!-- Dark Badge -->
                <span
                  class="primary-bg-color text-white text-[9px] font-bold tracking-widest uppercase px-2.5 py-0.5 rounded-t-xl shadow-2xs"
                >
                  VALIDATIONS
                </span>
                <!-- Card -->
                <div
                  class="bg-white border border-slate-200 rounded-xl shadow-[0_2px_10px_rgba(0,0,0,0.04)] px-3.5 py-2.5 flex items-center justify-between w-68 text-left hover:border-slate-300 hover:shadow-md transition-all"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div
                      class="w-8 h-8 rounded-lg border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-600 shrink-0"
                    >
                      <!-- Checkmark Icon -->
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.8"
                          d="M5 13l4 4L19 7"></path>
                      </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                      <span
                        class="text-xs font-semibold text-slate-900 leading-tight"
                      >
                        Validate supplier &amp; PO
                      </span>
                      <span
                        class="text-[11px] text-slate-500 leading-tight mt-0.5"
                      >
                        Check supplier registry · Match PO
                      </span>
                    </div>
                  </div>
                  <!-- Green Completed Check Badge -->
                  <div
                    class="wf-check-badge flex items-center justify-center shrink-0 ml-2"
                    data-wf-check="3"
                  >
                    <span
                      class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-xs"
                      title="Completed"
                    >
                      <svg
                        class="w-3 h-3 stroke-[2.5]"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"
                        ></path>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Connector Line 3 -->
              <div class="flex justify-center my-1 sm:my-1.5" data-wf-conn="3">
                <div
                  class="w-3 h-6 flex justify-center relative overflow-hidden"
                  data-wf-line
                >
                  <svg
                    class="w-3 h-6 overflow-visible"
                    viewBox="0 0 12 24"
                    fill="none"
                  >
                    <!-- Base Dashed Track -->
                    <line
                      x1="6"
                      y1="0"
                      x2="6"
                      y2="24"
                      stroke="#CBD5E1"
                      stroke-width="1.5"
                      stroke-dasharray="3 3"></line>
                  </svg>
                  <!-- Fading Gradient Live Stick -->
                  <div
                    class="wf-gradient-stick-v wf-glow-stick-v-delay-2"
                    data-wf-pulse="3"
                  >
                  </div>
                </div>
              </div>

              <!-- ================= STEP 4: RULES & SETTINGS ================= -->
              <div
                class="relative w-full flex items-center justify-center z-10"
              >
                <!-- Centered Rules Card -->
                <div class="flex flex-col items-center" data-wf-step="4">
                  <!-- Dark Badge -->
                  <span
                    class="primary-bg-color text-white text-[9px] font-bold tracking-widest uppercase px-2.5 py-0.5 rounded-t-xl shadow-2xs"
                  >
                    RULES
                  </span>
                  <!-- Card with Actions -->
                  <div
                    class="bg-white border border-slate-200 rounded-xl shadow-[0_2px_10px_rgba(0,0,0,0.04)] px-3.5 py-2.5 flex items-center justify-between w-72 text-left hover:border-slate-300 hover:shadow-md transition-all"
                  >
                    <div class="flex items-center gap-3 min-w-0">
                      <div
                        class="w-8 h-8 rounded-lg border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-700 font-semibold text-xs shrink-0"
                      >
                        ₹
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span
                          class="text-xs font-semibold text-slate-900 leading-tight"
                        >
                          Amount &gt; ₹5L?
                        </span>
                        <span
                          class="text-[11px] text-slate-500 leading-tight mt-0.5"
                        >
                          Conditional branch
                        </span>
                      </div>
                    </div>

                    <!-- Right side: Green checkmark badge + Action buttons -->
                    <div class="flex items-center gap-1.5 pl-2 shrink-0">
                      <div
                        class="wf-check-badge flex items-center justify-center shrink-0"
                        data-wf-check="4"
                      >
                        <span
                          class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-xs"
                          title="Completed"
                        >
                          <svg
                            class="w-3 h-3 stroke-[2.5]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M5 13l4 4L19 7"
                            ></path>
                          </svg>
                        </span>
                      </div>
                      <button
                        type="button"
                        class="text-[10px] text-slate-600 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded px-1.5 py-0.5 font-medium transition-colors cursor-pointer !p-1 !bg-slate-100 !text-slate-600"
                      >
                        Edit
                      </button>
                      <button
                        type="button"
                        class="text-[10px] text-slate-600 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded px-1.5 py-0.5 font-medium transition-colors cursor-pointer !p-1 !bg-slate-100 !text-slate-600"
                      >
                        + Step
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Floating "Rule Settings" Popup on the right (desktop only) -->
                <div
                  class="hidden lg:block absolute left-[calc(50%+240px)] -top-72 z-20 bg-white rounded-xl border border-slate-200/90 shadow-[0_8px_30px_rgba(0,0,0,0.08)] p-4 w-56 text-left"
                  data-wf-popup
                >
                  <!-- Header -->
                  <div
                    class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100"
                  >
                    <span class="text-xs font-bold text-slate-900">
                      Rule Settings
                    </span>
                    <span
                      class="text-slate-400 hover:text-slate-600 text-xs cursor-pointer select-none"
                    >
                      ✕
                    </span>
                  </div>

                  <!-- Field 1: Field -->
                  <div class="mb-3">
                    <label
                      class="block text-[10px] font-medium text-slate-500 mb-1"
                    >
                      Field
                    </label>
                    <div
                      class="w-full bg-[#F6F5F3] border border-slate-200 rounded-md px-2.5 py-1.5 text-xs text-slate-800 font-normal"
                    >
                      Invoice amount
                    </div>
                  </div>

                  <!-- Field 2: Operator -->
                  <div class="mb-3">
                    <label
                      class="block text-[10px] font-medium text-slate-500 mb-1"
                    >
                      Operator
                    </label>
                    <div
                      class="w-full bg-[#F6F5F3] border border-slate-200 rounded-md px-2.5 py-1.5 text-xs text-slate-800 font-normal flex items-center justify-between cursor-pointer"
                    >
                      <span>Greater than</span>
                      <svg
                        class="w-3 h-3 text-slate-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </div>
                  </div>

                  <!-- Field 3: Value -->
                  <div class="mb-4">
                    <label
                      class="block text-[10px] font-medium text-slate-500 mb-1"
                    >
                      Value
                    </label>
                    <div
                      class="w-full bg-white border-2 border-[#1E3A5F] rounded-md px-2.5 py-1.5 text-xs font-semibold text-slate-900 shadow-2xs"
                    >
                      ₹500,000
                    </div>
                  </div>

                  <!-- Save Button -->
                  <button
                    type="button"
                    class="w-full !bg-[#1E3A5F] hover:!bg-[#152B46] !text-white text-xs font-semibold !py-2 !px-3 rounded-md shadow-sm transition-colors text-center cursor-pointer !w-full"
                  >
                    Save
                  </button>
                </div>
              </div>

              <!-- ================= SVG FORK CONNECTORS ================= -->
              <div class="w-full max-w-155 h-12 relative my-1 sm:my-1.5" data-wf-fork>
                <svg
                  class="w-full h-full"
                  viewBox="0 0 620 48"
                  fill="none"
                  preserveAspectRatio="none"
                >
                  <defs>
                    <!-- Stem Mask (Height: 18px) -->
                    <mask id="stem-mask" maskUnits="userSpaceOnUse">
                      <path
                        id="mask-stem"
                        d="M 310 0 L 310 18"
                        stroke="white"
                        stroke-width="4"
                        stroke-dasharray="18"
                        stroke-dashoffset="18"></path>
                    </mask>
                    <!-- Left Fork Mask: center to (80, 18) then down to (80, 48). Total length = 230 + 30 = 260 -->
                    <mask id="left-fork-mask" maskUnits="userSpaceOnUse">
                      <path
                        id="mask-left-fork"
                        d="M 310 18 L 80 18 L 80 48"
                        stroke="white"
                        stroke-width="4"
                        stroke-dasharray="260"
                        stroke-dashoffset="260"></path>
                    </mask>
                    <!-- Right Fork Mask: center to (470, 18) then down to (470, 48). Total length = 160 + 30 = 190 -->
                    <mask id="right-fork-mask" maskUnits="userSpaceOnUse">
                      <path
                        id="mask-right-fork"
                        d="M 310 18 L 470 18 L 470 48"
                        stroke="white"
                        stroke-width="4"
                        stroke-dasharray="190"
                        stroke-dashoffset="190"></path>
                    </mask>
                    <!-- Fork Left Gradient for Fading Stick -->
                    <linearGradient
                      id="fork-grad-left"
                      x1="310"
                      y1="0"
                      x2="80"
                      y2="48"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop offset="0%" stop-color="#1E3A5F" stop-opacity="0.1"
                      ></stop>
                      <stop
                        offset="60%"
                        stop-color="#1E3A5F"
                        stop-opacity="0.55"></stop>
                      <stop offset="100%" stop-color="#1E3A5F" stop-opacity="1"
                      ></stop>
                    </linearGradient>
                    <!-- Fork Right Gradient for Fading Stick -->
                    <linearGradient
                      id="fork-grad-right"
                      x1="310"
                      y1="0"
                      x2="470"
                      y2="48"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop offset="0%" stop-color="#1E3A5F" stop-opacity="0.1"
                      ></stop>
                      <stop
                        offset="60%"
                        stop-color="#1E3A5F"
                        stop-opacity="0.55"></stop>
                      <stop offset="100%" stop-color="#1E3A5F" stop-opacity="1"
                      ></stop>
                    </linearGradient>
                  </defs>

                  <!-- Center stem down from Rule card -->
                  <path
                    d="M 310 0 L 310 18"
                    stroke="#CBD5E1"
                    stroke-width="1.5"
                    stroke-dasharray="3 3"
                    mask="url(#stem-mask)"></path>
                  <!-- Left branch to Auto-process -->
                  <path
                    d="M 310 18 L 80 18 L 80 48"
                    stroke="#CBD5E1"
                    stroke-width="1.5"
                    stroke-dasharray="3 3"
                    mask="url(#left-fork-mask)"></path>
                  <!-- Right branch to Create ERP transaction -->
                  <path
                    d="M 310 18 L 470 18 L 470 48"
                    stroke="#CBD5E1"
                    stroke-width="1.5"
                    stroke-dasharray="3 3"
                    mask="url(#right-fork-mask)"></path>
                  <!-- Left branch glowing live stick with fading tail -->
                  <g data-wf-fork-pulse="left">
                    <path
                      class="wf-fork-tail wf-fork-tail-l"
                      d="M 310 0 L 310 18 L 80 18 L 80 48"
                      stroke="#1E3A5F"
                      stroke-linecap="round"
                      stroke-dasharray="28 300"
                      stroke-dashoffset="28"></path>
                    <path
                      class="wf-fork-body wf-fork-body-l"
                      d="M 310 0 L 310 18 L 80 18 L 80 48"
                      stroke="#1E3A5F"
                      stroke-linecap="round"
                      stroke-dasharray="16 300"
                      stroke-dashoffset="16"></path>
                    <path
                      class="wf-fork-head wf-fork-head-l"
                      d="M 310 0 L 310 18 L 80 18 L 80 48"
                      stroke="#1E3A5F"
                      stroke-linecap="round"
                      stroke-dasharray="8 300"
                      stroke-dashoffset="8"></path>
                  </g>
                  <!-- Right branch glowing live stick with fading tail -->
                  <g data-wf-fork-pulse="right">
                    <path
                      class="wf-fork-tail wf-fork-tail-r"
                      d="M 310 0 L 310 18 L 470 18 L 470 48"
                      stroke="#1E3A5F"
                      stroke-linecap="round"
                      stroke-dasharray="28 230"
                      stroke-dashoffset="28"></path>
                    <path
                      class="wf-fork-body wf-fork-body-r"
                      d="M 310 0 L 310 18 L 470 18 L 470 48"
                      stroke="#1E3A5F"
                      stroke-linecap="round"
                      stroke-dasharray="16 230"
                      stroke-dashoffset="16"></path>
                    <path
                      class="wf-fork-head wf-fork-head-r"
                      d="M 310 0 L 310 18 L 470 18 L 470 48"
                      stroke="#1E3A5F"
                      stroke-linecap="round"
                      stroke-dasharray="8 230"
                      stroke-dashoffset="8"></path>
                  </g>
                </svg>

                <!-- NO Badge over left vertical line -->
                <div
                  class="absolute left-[12.9%] lg:left-20 top-6.5 -translate-x-1/2 -translate-y-1/2 z-10"
                  data-wf-badge="no"
                >
                  <span
                    class="bg-white border border-slate-200 text-slate-500 text-[9px] font-bold px-1.5 py-0.5 rounded shadow-2xs inline-block transition-all duration-300"
                  >
                    NO
                  </span>
                </div>

                <!-- YES Badge over right vertical line -->
                <div
                  class="absolute left-[75.8%] lg:left-117.5 top-6.5 -translate-x-1/2 -translate-y-1/2 z-10"
                  data-wf-badge="yes"
                >
                  <span
                    class="bg-white border border-slate-200 text-slate-500 text-[9px] font-bold px-1.5 py-0.5 rounded shadow-2xs inline-block transition-all duration-300"
                  >
                    YES
                  </span>
                </div>
              </div>
            </div>

            <!-- ================= BOTTOM ROW NODES ================= -->
            <div class="w-full flex justify-center">
              <div
                class="w-full grid grid-cols-2 gap-2.5 sm:gap-4 lg:flex lg:items-start lg:justify-center lg:gap-44 pt-0 z-10 max-w-sm sm:max-w-md lg:max-w-none mx-auto"
              >
                <!-- LEFT BRANCH: AUTO ROUTE -->
                <div class="flex flex-col items-center w-full lg:w-auto" data-wf-node="auto">
                  <span
                    class="primary-bg-color text-white text-[9px] font-bold tracking-widest uppercase px-2.5 py-0.5 rounded-t-xl shadow-2xs"
                  >

---
// UseCaseCtaSection.astro - Full-width gradient CTA banner for use case pages
import { siteLinks } from "../config/links";
import PhraseLines from "./PhraseLines.astro";

interface Props {
  title?: string;
  subtitle?: string;
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
}

const {
  title = "Try it on your own invoices.",
  subtitle = "Start free with 10 pages,\nor book a walkthrough with our team.",
  primaryCta = {
    text: "Get started",
    href: siteLinks.hero.getStarted,
  },
  secondaryCta = {
    text: "Book a Demo",
    href: siteLinks.footer.bookDemo,
  },
} = Astro.props;
---

<section class="w-full ">
  <div class="w-full mx-auto">
    <div
      class="cta-banner-gradient px-5 sm:px-12 py-14 sm:py-20 md:py-24 text-center relative overflow-hidden shadow-lg flex flex-col items-center justify-center"
    >
      <!-- Background Wave Animation -->
      <div class="footer-wave-wrapper absolute inset-0 w-full h-full pointer-events-none select-none z-0 overflow-hidden" aria-hidden="true">
        <canvas
          id="cta-wave-canvas"
          class="stripe-wave-canvas absolute inset-0 w-full h-full block"
          data-clear-color="#05274A"
          data-ref-width="1425"
          data-ref-height="783"
        ></canvas>
      </div>

      <!-- Background subtle noise / depth -->
      <div
        class="absolute inset-0 opacity-15 pointer-events-none select-none mix-blend-overlay z-[1]"
        style="background-image: url('/noise.webp'); background-repeat: repeat; background-size: 128px 128px;"
        aria-hidden="true"
      ></div>
      

      <!-- Main Headline -->
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-normal text-white tracking-tight leading-[1.15] font-cta-serif mb-4 sm:mb-5 relative z-10 text-balance"
      >
        <PhraseLines text={title} />
      </h2>

      <!-- Subtitle Description -->
      <p
        class="text-sm sm:text-base md:text-[17px] text-slate-200/90 leading-relaxed max-w-2xl mx-auto mb-8 sm:mb-9 font-normal relative z-10 text-balance"
      >
        <PhraseLines text={subtitle} />
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 relative z-10 w-full max-w-xs sm:max-w-none">
        <a
          href={primaryCta.href}
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 sm:px-8 py-3 rounded-full text-xs sm:text-sm font-semibold bg-white hover:bg-slate-100 text-slate-900 shadow-md transition-all duration-200 active:scale-[0.98] cursor-pointer text-center"
        >
          {primaryCta.text}
        </a>
        <a
          href={secondaryCta.href || siteLinks.footer.bookDemo}
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 sm:px-8 py-3 rounded-full text-xs sm:text-sm font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/25 shadow-2xs transition-all duration-200 active:scale-[0.98] cursor-pointer text-center"
        >
          {secondaryCta.text}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .font-cta-serif {
    font-family: "Newsreader", "Times New Roman", Times, serif;
    letter-spacing: -0.02em;
  }

  .cta-banner-gradient {
    background: linear-gradient(95deg, #747A91 0%, #3F608A 28%, #174771 62%, #05274A 100%);
  }

  .footer-wave-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    overflow: hidden;
    will-change: transform;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .footer-wave-wrapper canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }

  .footer-wave-wrapper canvas.wave-loaded {
    opacity: 1;
  }

  /* ─── Mobile: disable WebGL canvas & isolate paint layer ─────────────────── */
  @media (max-width: 1023px) {
    .cta-banner-gradient {
      contain: layout paint;
      -webkit-transform: translateZ(0);
      transform: translateZ(0);
    }

    .footer-wave-wrapper .stripe-wave-canvas {
      display: none !important;
    }
  }
</style>

<script>
  import { initFooterWaveAnimation } from "../animations/footerWaveAnimation";

  initFooterWaveAnimation();

  document.addEventListener("astro:page-load", () => {
    initFooterWaveAnimation();
  });
</script>


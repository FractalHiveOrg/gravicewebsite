---
// ConfigurableWorkflowsSection.astro - Configurable Workflows (STP + Exception routing + Rule settings)
import type { UseCaseData } from "../data/useCasesData";
import { useCasesData } from "../data/useCasesData";
import PhraseLines from "./PhraseLines.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  stp?: UseCaseData["workflows"]["stp"];
  exception?: UseCaseData["workflows"]["exception"];
  ruleSettings?: UseCaseData["workflows"]["ruleSettings"];
}

const defaultData = useCasesData["accounts-payable"].workflows;

const {  
  eyebrow = defaultData.eyebrow,
  title = defaultData.title,
  stp = defaultData.stp,
  exception = defaultData.exception,
  ruleSettings = defaultData.ruleSettings,
} = Astro.props;
---

<section class="w-full px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20 md:pb-24">
  <div class="max-w-7xl mx-auto">
    <!-- Eyebrow -->
    <p class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] text-slate-400 uppercase mb-3 sm:mb-4">
      {eyebrow}
    </p>

    <!-- Main Heading -->
    <h2 class="text-3xl sm:text-4xl lg:text-[46px] font-normal text-slate-900 tracking-tight leading-[1.15] font-cw-serif mb-10 sm:mb-12 md:mb-14 text-balance">
      <PhraseLines text={title} />
    </h2>

    <!-- Main 2-Column Grid: Workflows (Left) + Rule Settings (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-3 items-center">
      
      <!-- ================= LEFT: 2 WORKFLOW CANVASES ================= -->
      <div class="lg:col-span-9 flex flex-col gap-6 w-full">
        
        <!-- ── CANVAS 1: STP FLOW ────────────────────────────────────── -->
        <div class="bg-[#FBFAF8] rounded-2xl border border-slate-200/90 shadow-2xs overflow-hidden">
          <div class="flex items-center gap-2 pl-4 border-b border-slate-200/90 h-12">
            <span class="text-xs font-semibold text-slate-800 select-none">
              {stp.title}
            </span>
            <span class="text-slate-300 text-xs">|</span>
            <span class="text-[10px] sm:text-[11px] font-semibold text-slate-600 bg-white border border-primary rounded px-2 py-0.5 shadow-2xs select-none">
              {stp.badge}
            </span>
          </div>
          <div class="canvas-dot-grid p-4 sm:p-7 md:p-8 overflow-hidden lg:overflow-x-auto">
            <!-- Mobile Vertical Flow (lg:hidden) -->
            <div class="flex lg:hidden flex-col items-center justify-center py-3 w-full">
              <!-- Node 1 -->
              <div class="bg-white rounded-xl border border-slate-200/90 shadow-2xs px-4 py-2.5 flex items-center gap-3 w-full max-w-[270px]">
                <div class="w-7 h-7 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 text-slate-500">
                  {stp.step1.iconType === "doc" ? (
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  ) : stp.step1.iconType === "box" ? (
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  ) : (
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  )}
                </div>
                <span class="text-xs sm:text-sm font-semibold text-slate-800">
                  {stp.step1.title}
                </span>
              </div>

              <!-- Connector 1 -->
              <div class="w-4 h-6 flex justify-center relative overflow-hidden shrink-0">
                <div class="h-full border-l-2 border-dashed border-slate-300"></div>
                <div class="cw-gradient-stick-v-down"></div>
              </div>

              <!-- Node 2 (Navy Gradient) -->
              <div class="bg-linear-to-r from-[#1A3F69] to-[#0E2845] text-white rounded-xl shadow-xs px-4 py-2.5 flex items-center gap-2.5 w-full max-w-[270px]">
                <div class="w-5 h-5 rounded bg-white/15 flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <span class="text-[11px] sm:text-xs font-bold tracking-wider text-white uppercase">
                  {stp.step2.title}
                </span>
              </div>

              <!-- Connector 2 -->
              <div class="w-4 h-6 flex justify-center relative overflow-hidden shrink-0">
                <div class="h-full border-l-2 border-dashed border-slate-300"></div>
                <div class="cw-gradient-stick-v-down cw-stick-delay-1"></div>
              </div>

              <!-- Node 3 -->
              <div class="bg-white rounded-xl border border-slate-200/90 shadow-2xs px-4 py-2.5 flex items-center gap-3 w-full max-w-[270px]">
                <div class="w-7 h-7 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 text-slate-500">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                  </svg>
                </div>
                <span class="text-xs sm:text-sm font-semibold text-slate-800">
                  {stp.step3.title}
                </span>
              </div>

              {stp.step4 && (
                <>
                  <!-- Connector 3 -->
                  <div class="w-4 h-6 flex justify-center relative overflow-hidden shrink-0">
                    <div class="h-full border-l-2 border-dashed border-slate-300"></div>
                    <div class="cw-gradient-stick-v-down cw-stick-delay-2"></div>
                  </div>

                  <!-- Node 4 -->
                  <div class="bg-white rounded-xl border border-slate-200/90 shadow-2xs px-4 py-2.5 flex items-center gap-3 w-full max-w-[270px]">
                    <div class="w-7 h-7 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 text-slate-500">
                      {stp.step4.iconType === "truck" ? (
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8h4l3 3v5a1 1 0 01-1 1h-1" />
                        </svg>
                      ) : stp.step4.iconType === "user" ? (
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                      ) : (
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                        </svg>
                      )}
                    </div>
                    <span class="text-xs sm:text-sm font-semibold text-slate-800">
                      {stp.step4.title}
                    </span>
                  </div>
                </>
              )}
            </div>

            <!-- Desktop Horizontal Flow Diagram (hidden on mobile, visible on lg) -->
            <div class="hidden lg:flex min-w-0 items-center justify-center py-4">
              <!-- Node 1 -->
              <div class="bg-white rounded-xl border border-slate-200/90 shadow-2xs px-4 sm:px-5 py-3 flex items-center gap-3 shrink-0">
                <div class="w-7 h-7 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 text-slate-500">
                  {stp.step1.iconType === "doc" ? (
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  ) : stp.step1.iconType === "box" ? (
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  ) : (
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  )}
                </div>
                <span class="text-xs sm:text-sm font-semibold text-slate-800 whitespace-nowrap">
                  {stp.step1.title}
                </span>
              </div>

              <!-- Dashed Connector 1 with Live Stick -->
              <div class="w-10 sm:w-14 h-4 flex items-center relative overflow-hidden shrink-0">
                <div class="w-full border-t-2 border-dashed border-slate-300"></div>
                <div class="cw-gradient-stick-h"></div>
              </div>

              <!-- Node 2 (Navy Gradient) -->
              <div class="bg-linear-to-r from-[#1A3F69] to-[#0E2845] text-white rounded-xl shadow-xs px-4 sm:px-5 py-3 flex items-center gap-2.5 shrink-0">
                <div class="w-5 h-5 rounded bg-white/15 flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <span class="text-[11px] sm:text-xs font-bold tracking-wider text-white uppercase whitespace-nowrap">
                  {stp.step2.title}
                </span>
              </div>

              <!-- Dashed Connector 2 with Live Stick -->
              <div class="w-10 sm:w-14 h-4 flex items-center relative overflow-hidden shrink-0">
                <div class="w-full border-t-2 border-dashed border-slate-300"></div>
                <div class="cw-gradient-stick-h cw-stick-delay-1"></div>
              </div>

              <!-- Node 3 -->
              <div class="bg-white rounded-xl border border-slate-200/90 shadow-2xs px-4 sm:px-5 py-3 flex items-center gap-3 shrink-0">
                <div class="w-7 h-7 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 text-slate-500">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                  </svg>
                </div>
                <span class="text-xs sm:text-sm font-semibold text-slate-800 whitespace-nowrap">
                  {stp.step3.title}
                </span>
              </div>

              {stp.step4 && (
                <>
                  <!-- Dashed Connector 3 with Live Stick -->
                  <div class="w-10 sm:w-14 h-4 flex items-center relative overflow-hidden shrink-0">
                    <div class="w-full border-t-2 border-dashed border-slate-300"></div>
                    <div class="cw-gradient-stick-h cw-stick-delay-2"></div>
                  </div>

                  <!-- Node 4 -->
                  <div class="bg-white rounded-xl border border-slate-200/90 shadow-2xs px-4 sm:px-5 py-3 flex items-center gap-3 shrink-0">
                    <div class="w-7 h-7 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 text-slate-500">
                      {stp.step4.iconType === "truck" ? (
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8h4l3 3v5a1 1 0 01-1 1h-1" />
                        </svg>
                      ) : stp.step4.iconType === "user" ? (
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                      ) : (
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                        </svg>
                      )}
                    </div>
                    <span class="text-xs sm:text-sm font-semibold text-slate-800 whitespace-nowrap">
                      {stp.step4.title}
                    </span>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>

        <!-- ── CANVAS 2: EXCEPTION FLOW ──────────────────────────────── -->
        <div class="bg-[#FBFAF8] rounded-2xl border border-slate-200/90 shadow-2xs overflow-hidden">
          <div class="flex items-center gap-2 w-full h-12 pl-4 border-b border-slate-200/90">
            <span class="text-xs font-semibold text-slate-800 select-none">
              {exception.title}
            </span>
            <span class="text-slate-300 text-xs">|</span>
            <span class="text-[10px] sm:text-[11px] font-semibold text-slate-600 bg-white border border-primary rounded px-2 py-0.5 shadow-2xs select-none">
              {exception.badge}
            </span>
          </div>
          <div class="canvas-dot-grid p-4 sm:p-7 md:p-8 overflow-hidden lg:overflow-x-auto">
            <!-- Mobile Branching Flowchart (lg:hidden) -->
            <div class="flex lg:hidden flex-col items-center justify-center py-2 w-full">
              <!-- Left Icon: Dark Navy Lightning Box -->
              <div class="w-10 h-10 rounded-xl bg-linear-to-b from-[#1C3A5E] to-[#0A223B] flex items-center justify-center text-white shadow-xs shrink-0 border border-[#23486F]/40">
                <svg class="w-4.5 h-4.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>

              <!-- Dashed Connector down with Live Stick -->
              <div class="w-4 h-5 flex justify-center relative overflow-hidden shrink-0 my-0.5">
                <div class="h-full border-l-2 border-dashed border-slate-300"></div>
                <div class="cw-gradient-stick-v-down"></div>
              </div>

              <!-- Decision Node: Rules -->
              <div class="relative bg-white rounded-xl border border-slate-200/90 shadow-2xs px-3.5 py-2.5 w-full max-w-[260px] flex items-center gap-3">
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#0A223B] text-white text-[8px] font-bold px-2 py-0.5 rounded-t-lg uppercase tracking-wider shadow-2xs select-none whitespace-nowrap">
                  {exception.ruleNode.badge}
                </span>
                <div class="w-7 h-7 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 text-slate-700 font-semibold text-xs">
                  {exception.ruleNode.symbol === "doc" ? (
                    <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  ) : (
                    exception.ruleNode.symbol
                  )}
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-900 leading-tight">
                    {exception.ruleNode.title}
                  </p>
                  <p class="text-[10px] text-slate-400 mt-0.5 whitespace-nowrap">
                    {exception.ruleNode.subtitle}
                  </p>
                </div>
              </div>

              <!-- Branching Split Fork SVG (Mobile) -->
              <div class="w-full max-w-[280px] h-9 relative my-1">
                <svg class="w-full h-full" viewBox="0 0 200 36" fill="none" preserveAspectRatio="none">
                  <!-- Base Tracks: Stem and Left/Right drops -->
                  <path d="M 100,0 L 100,14 L 50,14 L 50,36" stroke="#CBD5E1" stroke-width="1.8" stroke-dasharray="3 3" fill="none" />
                  <path d="M 100,14 L 150,14 L 150,36" stroke="#CBD5E1" stroke-width="1.8" stroke-dasharray="3 3" fill="none" />

                  <!-- Left (NO) Pulse -->
                  <g class="cw-branch-pulse cw-branch-pulse-no">
                    <path class="cw-fork-tail" d="M 100,0 L 100,14 L 50,14 L 50,36" stroke="#1E3A5F" stroke-linecap="round" fill="none" />
                    <path class="cw-fork-body" d="M 100,0 L 100,14 L 50,14 L 50,36" stroke="#1E3A5F" stroke-linecap="round" fill="none" />
                    <path class="cw-fork-head" d="M 100,0 L 100,14 L 50,14 L 50,36" stroke="#1E3A5F" stroke-linecap="round" fill="none" />
                  </g>

                  <!-- Right (YES) Pulse -->
                  <g class="cw-branch-pulse cw-branch-pulse-yes">
                    <path class="cw-fork-tail" d="M 100,14 L 150,14 L 150,36" stroke="#1E3A5F" stroke-linecap="round" fill="none" />
                    <path class="cw-fork-body" d="M 100,14 L 150,14 L 150,36" stroke="#1E3A5F" stroke-linecap="round" fill="none" />
                    <path class="cw-fork-head" d="M 100,14 L 150,14 L 150,36" stroke="#1E3A5F" stroke-linecap="round" fill="none" />
                  </g>
                </svg>

                <!-- NO Badge over left vertical line -->
                <span class="absolute top-4.5 left-[25%] -translate-x-1/2 -translate-y-1/2 bg-white border border-slate-200/90 text-slate-500 font-semibold text-[8px] px-1.5 py-0.25 rounded shadow-2xs select-none">
                  {exception.noBranch.badge}
                </span>

                <!-- YES Badge over right vertical line -->
                <span class="absolute top-4.5 left-[75%] -translate-x-1/2 -translate-y-1/2 bg-white border border-slate-200/90 text-slate-500 font-semibold text-[8px] px-1.5 py-0.25 rounded shadow-2xs select-none">
                  {exception.yesBranch.badge}
                </span>
              </div>

              <!-- 2-Column Responsive Grid: NO (Left) & YES (Right) -->
              <div class="w-full grid grid-cols-2 gap-2 sm:gap-3 max-w-sm mx-auto">
                <!-- ── Left Column (NO: Auto-process -> Success) -->
                <div class="flex flex-col items-center w-full">
                  <!-- Node 1: Auto-process -->
                  <div class="relative bg-white rounded-xl border border-slate-200/90 shadow-2xs p-2 sm:p-2.5 w-full flex items-center gap-2">
                    <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#0A223B] text-white text-[8px] font-bold px-2 py-0.25 rounded-t-lg uppercase tracking-wider shadow-2xs select-none whitespace-nowrap">
                      {exception.noBranch.node1.badge}
                    </span>
                    <div class="w-6 h-6 rounded-lg bg-slate-50 border border-slate-200/80 flex items-center justify-center shrink-0 text-slate-600">
                      {exception.noBranch.node1.iconType === "route" ? (
                        <svg class="w-3.5 h-3.5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="6" cy="18" r="2" />
                          <circle cx="6" cy="6" r="2" />
                          <circle cx="18" cy="18" r="2" />
                          <path d="M6 8v8" />
                          <path d="M18 16a6 6 0 0 0-6-6H6" />
                        </svg>
                      ) : exception.noBranch.node1.iconType === "user" ? (
                        <svg class="w-3 h-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                      ) : (
                        <svg class="w-3 h-3 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                        </svg>
                      )}
                    </div>
                    <div class="min-w-0">
                      <p class="text-[11px] font-bold text-slate-900 leading-tight truncate">
                        {exception.noBranch.node1.title}
                      </p>
                      <p class="text-[9px] text-slate-400 mt-0.5 truncate">
                        {exception.noBranch.node1.subtitle}
                      </p>
                    </div>
                  </div>

                  <!-- Connector down -->
                  <div class="w-4 h-5 flex justify-center relative overflow-hidden shrink-0 my-1">
                    <div class="h-full border-l-2 border-dashed border-slate-300"></div>
                    <div class="cw-gradient-stick-v-down"></div>
                  </div>

                  <!-- Node 2: Green Success Card -->
                  <div class="relative bg-linear-to-r from-[#1A4B35] to-[#346E50] text-white rounded-xl shadow-xs p-2 sm:p-2.5 w-full flex items-center gap-2">
                    <div class="w-6 h-6 rounded-lg bg-white/15 flex items-center justify-center shrink-0">
                      {exception.noBranch.node2.iconType === "truck" ? (

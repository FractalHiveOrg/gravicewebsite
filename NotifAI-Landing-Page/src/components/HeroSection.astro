---
import { siteLinks } from "../config/links";

// Rotating hero headline + subtitle (loops in order, see heroTextAnimation.ts).
// Each entry in `subtitleLines` is broken onto its own line from the sm breakpoint up.
const heroSlides = [
  {
    title: "Make your business autonomous.",
    subtitleLines: [
      "Nico picks up every invoice, order and request",
      "and carries it to completion.",
    ],
  },
  {
    title: "Your clients’ documents, straight into Tally.",
    subtitleLines: [
      "Nico reads every file your clients send via WhatsApp or email, validates GSTIN, prepares vouchers, and posts to Tally.",
    ],
  },
  {
    title: "Your business, Your process.",
    subtitleLines: [
      "Configure your processes, your SLAs, your rules.",
      "Nico does the rest.",
    ],
  },
];

const streamCards = [
 {
    title: "Payment Advice",
    subtitle: "Barclays Commercial | 31 mins ago",
    logoSrc: "/logos/gmail.svg",
    logoAlt: "Gmail",
    logoType: "svg",

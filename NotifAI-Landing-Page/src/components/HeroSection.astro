    logoSrc: "/logos/tallyprime.png",
    logoAlt: "SAP",
    logoType: "badge",
    logoClass: "w-full h-full object-contain",
    badgeClass: "bg-white rounded-xl p-2 w-28 sm:w-32 h-12 sm:h-14 flex items-center justify-center shadow-md",
  },
  {
    title: "Content Uploaded",
    subtitle: "Vendor Agreement.pdf | 26 mins ago",
    logoSrc: "/logos/onedrive.png",
    logoAlt: "OneDrive",
    logoType: "image",
    logoClass: "w-20 sm:w-24 h-auto object-contain drop-shadow-lg",
  },
  
   {
    title: "Invoice received via email",
    subtitle: "AeroBreak Suppliers | 14 mins ago",
    logoSrc: "/logos/gmail.svg",
    logoAlt: "Gmail",
    logoType: "svg",
    logoClass: "w-12 h-12 sm:w-14 sm:h-14 object-contain drop-shadow-md",
  },
  {
    title: "Dispatch Confirmation",
    subtitle: "SwiftFreight International | 37 mins ago",
    logoSrc: "/logos/whatsapp.svg",
    logoAlt: "WhatsApp",
    logoType: "svg",
    logoClass: "w-12 h-12 sm:w-14 sm:h-14 object-contain drop-shadow-md",
  },
  {
    title: "ERP Master Record Sync",
    subtitle: "Enterprise Materials ERP | 43 mins ago",
    logoSrc: "/logos/tallyprime.png",
    logoAlt: "SAP",
    logoType: "badge",
    logoClass: "w-full h-full object-contain",
    badgeClass: "bg-white rounded-xl p-2 w-28 sm:w-32 h-12 sm:h-14 flex items-center justify-center shadow-md",
  },
  {
    title: "Bill of Lading Scanned",
    subtitle: "Pacific Cargo Liner | 49 mins ago",
    logoSrc: "/logos/onedrive.png",
    logoAlt: "OneDrive",
    logoType: "image",
    logoClass: "w-20 sm:w-24 h-auto object-contain drop-shadow-lg",
  },
  {
    title: "Supplier Quotation",
    subtitle: "Apex Industrial Supply | 55 mins ago",
    logoSrc: "/logos/gmail.svg",
    logoAlt: "Gmail",
    logoType: "svg",
    logoClass: "w-12 h-12 sm:w-14 sm:h-14 object-contain drop-shadow-md",
  },
  // {
  //   title: "Delivery Status Update",
  //   subtitle: "Northwind Carriers | 1 hr ago",
  //   logoSrc: "/logos/whatsapp.svg",
  //   logoAlt: "WhatsApp",
  //   logoType: "svg",
  //   logoClass: "w-12 h-12 sm:w-14 sm:h-14 object-contain drop-shadow-md",
  // },
  // {
  //   title: "Contract Settlement",
  //   subtitle: "Sterling Corporate Legal | 1 hr ago",
  //   logoSrc: "/logos/sap.png",
  //   logoAlt: "SAP",
  //   logoType: "badge",
  //   logoClass: "w-full h-full object-contain",
  //   badgeClass: "bg-white rounded-xl p-2 w-28 sm:w-32 h-12 sm:h-14 flex items-center justify-center shadow-md",
  // },
  // {
  //   title: "Compliance Pack v3",
  //   subtitle: "Regulatory Audit.pdf | 2 hrs ago",

---
import { Image } from "astro:assets";
import { siteLinks } from "../config/links";
import unstructuredDataImg from "../assets/unteructuredData.png";
import pdfLogoImg from "../assets/logos/pdfLogo.png";
import imageLogoImg from "../assets/logos/imageLogp.png";
import mailLogoImg from "../assets/logos/mail.png";
---

<section
  id="hero-section"
  class="hero-section w-full md:min-h-[90vh] min-h-[70vh] sm:h-[95vh] flex justify-center items-center relative pointer-events-none tactile-dot-bg bg-white rounded-t-4xl"
>
  <div
    class="relative w-full max-w-7xl px-4 sm:px-8 text-center flex flex-col gap-8 sm:gap-16 justify-center items-center rounded-3xl pointer-events-auto"
  >
    <div class="flex flex-col gap-4 sm:gap-6">
      <div>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-slate-900">
          Make your Business <br> Processes Autonomous
        </h1>
        <p class="text-sm sm:text-xl text-[#8B8F95] mt-3">
         Connect the systems, data, documents, AI and people behind your operations.
        </p>
      </div>
      <div>
        <a href={siteLinks.hero.getStarted} class="inline-block">
          <button
            class="text-sm sm:text-base px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl"
            >Get Started Now</button
          >
        </a>
      </div>
    </div>
    <div
      class="relative w-full max-w-[340px] sm:max-w-xl md:max-w-2xl mx-auto flex items-center justify-center select-none py-6 sm:py-0"
    >
      <!-- Center Main Illustration (Folder with files) -->
      <div class="relative z-10 flex items-center justify-center">
        <Image
          src={unstructuredDataImg}
          alt="Unstructured Data to Agentic Workflows"
          width={520}
          format="webp"
          quality={85}
          class="w-64 sm:w-100 md:w-115 lg:w-125 h-auto object-contain pointer-events-auto"
          loading="eager"
        />
      </div>

      <!-- 1. Top-Left: Word Card (logo1.svg) -->
      <div
        class="word-box absolute -top-5 sm:top-[4%] left-0 sm:left-[14%] md:left-[16%] z-20 pointer-events-auto"
      >
        <div class="card-float-inner">
          <div
            class="w-18 h-18 md:w-20 md:h-20 lg:w-22 lg:h-22 bg-white rounded-2xl sm:rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-slate-100 flex items-center justify-center p-2.5 sm:p-3 hover:scale-105 transition-transform duration-300"
          >
            <img
              src="/logos/logo1.svg"
              alt="Word Document"
              class="w-full h-full object-contain"
            />
          </div>
        </div>
      </div>

      <!-- 2. Mid-Left: PDF Card (pdfLogo.png) -->
      <div
        class="pdf-box absolute top-1/2 -translate-y-1/2 sm:translate-y-0 sm:top-[38%] -left-4 sm:left-[7%] md:left-[9%] z-20 pointer-events-auto"
      >
        <div class="card-float-inner">
          <div
            class="w-18 h-18 md:w-20 md:h-20 lg:w-22 lg:h-22 bg-white rounded-2xl sm:rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-slate-100 flex items-center justify-center p-2.5 sm:p-3 hover:scale-105 transition-transform duration-300"
          >
            <Image
              src={pdfLogoImg}
              alt="PDF File"
              width={88}
              height={88}
              format="webp"
              quality={85}
              class="w-full h-full object-contain"
            />
          </div>
        </div>
      </div>

      <!-- 3. Bottom-Left: PNG Card (imageLogp.png) -->
      <div
        class="png-box absolute -bottom-5 sm:bottom-[-6%] left-2 sm:left-[20%] md:left-[22%] z-20 pointer-events-auto"
      >
        <div class="card-float-inner">
          <div
            class="w-18 h-18 md:w-20 md:h-20 lg:w-22 lg:h-22 bg-white rounded-2xl sm:rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-slate-100 flex items-center justify-center p-2.5 sm:p-3 hover:scale-105 transition-transform duration-300"
          >
            <Image
              src={imageLogoImg}
              alt="PNG Image"
              width={88}
              height={88}
              format="webp"
              quality={85}
              class="w-full h-full object-contain"
            />
          </div>
        </div>
      </div>

      <!-- 4. Top-Right: WhatsApp Card (whatsapp.svg) -->
      <div
        class="whatsapp-box absolute -top-5 sm:top-[2%] right-0 sm:right-[14%] md:right-[16%] z-20 pointer-events-auto"
      >
        <div class="card-float-inner">
          <div
            class="w-18 h-18 md:w-20 md:h-20 lg:w-22 lg:h-22 bg-white rounded-2xl sm:rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-slate-100 flex items-center justify-center p-2.5 sm:p-3 hover:scale-105 transition-transform duration-300"
          >
            <img
              src="/logos/whatsapp.svg"
              alt="WhatsApp"
              width={108}
              height={108}
              class="w-full h-full object-contain"
            />
          </div>
        </div>
      </div>

      <!-- 5. Mid-Right: Gmail Card (gmail.svg) -->
      <div
        class="gmail-box absolute top-1/2 -translate-y-1/2 sm:translate-y-0 sm:top-[36%] -right-4 sm:right-[7%] md:right-[9%] z-20 pointer-events-auto"
      >
        <div class="card-float-inner">
          <div
            class="w-18 h-18 md:w-20 md:h-20 lg:w-22 lg:h-22 bg-white rounded-2xl sm:rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-slate-100 flex items-center justify-center p-2.5 sm:p-3 hover:scale-105 transition-transform duration-300"
          >
            <img
              src="/logos/gmail.svg"
              alt="Gmail"
              class="w-full h-full object-contain"
            />
          </div>
        </div>
      </div>

      <!-- 6. Bottom-Right: Outlook Card (mail.png) -->
      <div
        class="outlook-box absolute -bottom-5 sm:bottom-[-6%] right-2 sm:right-[20%] md:right-[15%] z-20 pointer-events-auto"
      >
        <div class="card-float-inner">
          <div
            class="w-18 h-18 md:w-20 md:h-20 lg:w-22 lg:h-22 bg-white rounded-2xl sm:rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-slate-100 flex items-center justify-center p-2.5 sm:p-3 hover:scale-105 transition-transform duration-300"
          >
            <Image
              src={mailLogoImg}
              alt="Outlook Mail"
              width={88}
              height={88}
              format="webp"
              quality={85}
              class="w-full h-full object-contain"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

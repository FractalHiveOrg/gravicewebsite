---
import { Image } from "astro:assets";
import ingestIcon from "../assets/01-ingest 1.svg";
import classifyIcon from "../assets/02-classify 1.svg";
import extractIcon from "../assets/03-extract 1.svg";
import validateIcon from "../assets/04-validate 1.svg";
import pushIcon from "../assets/05-push 1.svg";

const workflowSteps = [
  {
    step: "01",
    title: "Ingest",
    subtitle: "Connect",
    icon: ingestIcon,
    alt: "Ingest icon",
  },
  {
    step: "02",
    title: "Classify",
    subtitle: "Understand",
    icon: classifyIcon,
    alt: "Classify icon",
  },
  {
    step: "03",
    title: "Extract",
    subtitle: "Structure",
    icon: extractIcon,
    alt: "Extract icon",
  },
  {
    step: "04",
    title: "Validate",
    subtitle: "Verify",
    icon: validateIcon,
    alt: "Validate icon",
  },
  {
    step: "05",
    title: "Push",
    subtitle: "Sync",
    icon: pushIcon,
    alt: "Push icon",
  },
];
---

<section
  id="workflow-section"
  class="workflow-section w-full md:min-h-screen flex items-center justify-center bg-white  relative z-20 section-bg-dot py-20 lg:py-28 px-6 sm:px-10 lg:px-14"
>
  <div class="w-full max-w-7xl mx-auto flex flex-col items-start ">
    <!-- Badge -->
    <div class="overflow-hidden w-fit rounded-full mb-4">
      <span
        class="workflow-badge bg-[#1E3A5F] text-white text-xs font-bold uppercase tracking-[0.14em] px-4 py-1.5 rounded-full inline-block"
        style="opacity: 0; transform: translateY(120%);"
      >
        END-TO-END WORKFLOW
      </span>
    </div>

    <!-- Main Title -->
    <h2
      class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-bold text-slate-900 tracking-tight leading-[1.15] mb-4 max-w-4xl"
    >
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top">
        <span class="workflow-word inline-block" style="opacity: 0; transform: translateY(130%);">From</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top">
        <span class="workflow-word inline-block" style="opacity: 0; transform: translateY(130%);">incoming</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top">
        <span class="workflow-word inline-block" style="opacity: 0; transform: translateY(130%);">document</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top">
        <span class="workflow-word inline-block" style="opacity: 0; transform: translateY(130%);">to</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top">
        <span class="workflow-word inline-block" style="opacity: 0; transform: translateY(130%);">ERP</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top">
        <span class="workflow-word inline-block" style="opacity: 0; transform: translateY(130%);">-</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 align-top">
        <span class="workflow-word inline-block text-[#1E3A5F]" style="opacity: 0; transform: translateY(130%);">Autonomously</span>
      </span>
    </h2>

    <!-- Subtitle Description -->
    <p
      class="workflow-subtitle text-sm sm:text-base md:text-lg text-slate-600 max-w-3xl leading-relaxed mb-14 sm:mb-16 md:mb-20"
      style="opacity: 0; transform: translateY(20px);"
    >
      Nico sits between your document sources and downstream systems, turning unstructured paperwork into validated operational data.
    </p>

    <!-- 5 Workflow Cards Row -->
    <div
      class="w-full flex flex-col md:flex-row items-center justify-center gap-3 sm:gap-4 lg:gap-3 xl:gap-4.5"
    >
      {
        workflowSteps.map((item, index) => (
          <>
            <!-- Step Card -->
            <div
              class="workflow-card-item w-full max-w-[280px] sm:max-w-[220px] md:w-[175px] lg:w-[195px] xl:w-[215px] h-[250px] sm:h-[270px] lg:h-[290px] bg-white rounded-2xl sm:rounded-[22px] p-5 sm:p-6 border border-black/[0.06] shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_12px_32px_rgba(0,0,0,0.08)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between items-start text-left select-none group"
              style="opacity: 0; transform: translateY(35px);"
            >
              <!-- Step Badge -->
              <div class="w-6 h-6 rounded-full bg-[#1E3A5F] text-white text-[11px] font-bold flex items-center justify-center shrink-0">
                {item.step}
              </div>

              <!-- SVG Icon -->
              <div class="w-full flex items-center justify-center my-auto py-2 group-hover:scale-105 transition-transform duration-300">
                <Image
                  src={item.icon}
                  alt={item.alt}
                  width={64}
                  height={64}
                  class="w-13 h-13 sm:w-14 sm:h-14 lg:w-16 lg:h-16 object-contain"
                />
              </div>

              <!-- Step Info -->
              <div class="mt-auto">
                <h3 class="text-base sm:text-[17px] font-bold text-slate-900 leading-tight">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-[13px] text-slate-400 font-normal mt-0.5">
                  {item.subtitle}
                </p>
              </div>
            </div>

            <!-- Connecting Arrow (Between cards) -->
            {index < workflowSteps.length - 1 && (
              <div
                class="workflow-arrow text-slate-400 hidden md:flex items-center justify-center shrink-0 px-0.5 lg:px-1"
                style="opacity: 0; transform: translateX(-10px);"
              >
                <svg
                  class="w-4 h-4 lg:w-5 lg:h-5 text-slate-400/80"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .workflow-word {
    transform: translateY(130%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .workflow-card-item {
    transform: translateY(35px);
    opacity: 0;
    will-change: transform, opacity;
  }
</style>

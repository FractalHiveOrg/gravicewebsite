---
// src/components/PinTransform.astro
---
<section class="pin-transform-section">
  <div class="pin-target">
    <span class="pin-label">Scroll</span>
  </div>
</section>

<style>
  .pin-transform-section {
    height: 300vh; /* controls how long the scroll effect lasts */
    position: relative;
    background: #f1f5f9;
  }

  .pin-target {
    width: 120px;
    height: 120px;
    background: #6366f1;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    /* start centered in the viewport */
    position: relative;
    top: 40vh;
    left: 50%;
    transform: translateX(-50%);
  }

  .pin-label {
    pointer-events: none;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

  function initPinTransform() {
    const section = document.querySelector('.pin-transform-section');
    const target = document.querySelector('.pin-target');
    if (!section || !target) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: 'bottom top',
        pin: target,
        scrub: 1,
      },
    });

    // 1. Move and transform along the curve (first 85% of scroll)
        // 1. Move and transform along curve (e.g. 80% of scroll)
    tl.to(target, {
      scale: 2, // or keep whatever peak scale you want
      borderRadius: '0',
      backgroundColor: '#ef4444',
      rotation: 90,
      motionPath: {
        path: [
          { x: 0, y: 0 },
          { x: 250, y: -120 },
          { x: -150, y: 100 },
          { x: 200, y: 300 },
        ],
        curviness: 1.5,
        autoRotate: false,
      },
      duration: 0.8,
      ease: 'none',
    })
    // 2. At the end (last 20% of scroll), shrink it down and fade out
    .to(target, {
      scale: -30,          // shrinks size down to 0 (use 0.2, 0.5 etc. if you just want it smaller)
      autoAlpha: 0,      // fades out smoothly
      display: 'none',
      duration: 0.2,     // takes 20% of the total scroll distance
      ease: 'power1.in',
    });

  }

  initPinTransform();

  document.addEventListener('astro:page-load', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
    initPinTransform();
  });
</script>
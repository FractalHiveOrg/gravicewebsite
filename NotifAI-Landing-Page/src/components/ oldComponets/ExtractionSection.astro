---
import { Image } from "astro:assets";
import invoiceImg from "../assets/images/sample-invoice-INV-2026-1847-538x676@2x.png";
---

<section
  id="extraction-section"
  class="extraction-section w-full md:min-h-screen flex flex-col-reverse md:flex-row justify-center items-center relative z-20 section-bg-dot bg-white py-6 md:py-0"
>
  <div
    id="extraction-card-column"
    class="w-full md:w-4/5 h-full flex justify-center items-center px-4 sm:px-6 md:px-0 py-8 md:py-0"
  >
    <div
      id="extraction-scanner-card"
      class="scanner-card-container relative bg-white rounded-3xl md:w-5/6 max-w-135 shadow-xl border border-slate-100 text-left overflow-hidden select-none"
    >
      <!-- Scanner Laser Line (Colored green line directly at the border between doc and converted one) -->
      <div
        id="scanner-laser-line"
        class="scanner-laser-line absolute left-0 right-0 z-40 pointer-events-none opacity-0"
      >
        <!-- Glowing colored laser line directly on the dividing border -->
        <div class="laser-beam-bar w-full"></div>
        <!-- Ambient colored glow sheen across the seam -->
        <div class="laser-glow-sheen absolute inset-x-0 pointer-events-none"></div>
        <!-- Scanner HUD Badge -->
      
      </div>

      <!-- LAYER 1: Raw Document Input Layer (Visible before scan line passes) -->
      <div
        id="scanner-input-layer"
        class="scanner-input-layer absolute inset-0 w-full h-full pointer-events-none select-none overflow-hidden bg-white opacity-0 rounded-3xl z-10"
      >
        <Image
          src={invoiceImg}
          alt="Sample Invoice INV-2026-1847"
          width={540}
          format="webp"
          quality={85}
          class="w-full h-full object-cover object-top rounded-3xl"
          loading="eager"
        />
      </div>

      <!-- LAYER 2: Extracted Output Details Layer (Revealed behind scan line) -->
      <div id="scanner-output-layer" class="scanner-output-layer w-full p-6 text-left relative bg-white rounded-3xl">
        <p class="text-xl font-bold text-slate-900 mb-4">
          Extracted Invoice details
        </p>

        <div class="space-y-3">
          <!-- Row 1: Invoice number & Invoice date -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1"
                >Invoice number</label
              >
              <div
                class="w-full bg-white border border-slate-200 rounded-xl px-3.5 py-2 text-sm text-slate-800 font-medium"
              >
                <span id="val-invoice-no" class="inline-block will-change-transform">INV-2026-1847</span>
              </div>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1"
                >Invoice date</label
              >
              <div
                class="w-full bg-white border border-slate-200 rounded-xl px-3.5 py-2 text-sm text-slate-800 font-medium"
              >
                <span id="val-invoice-date" class="inline-block will-change-transform">8 September 2026</span>
              </div>
            </div>
          </div>

          <!-- Row 2: Supplier -->
          <div>
            <label class="block text-xs font-medium text-slate-500 mb-1"
              >Supplier</label
            >
            <div
              class="w-full bg-white border border-slate-200 rounded-xl px-3.5 py-2 text-sm text-slate-800 font-medium"
            >
              <span id="val-supplier" class="inline-block will-change-transform">Acme Metals Ltd.</span>
            </div>
          </div>

          <!-- Row 3: GSTIN Number -->
          <div>
            <label class="block text-xs font-medium text-slate-500 mb-1"
              >GSTIN Number</label
            >
            <div
              class="w-full bg-white border-2 border-emerald-500 rounded-xl px-3.5 py-2 text-sm text-slate-800 font-medium"
            >
              <span id="val-gstin" class="inline-block will-change-transform">GST12345678IN90</span>
            </div>
          </div>

          <!-- GSTIN verification alert -->
          <div
            class="bg-[#EFFFF3] border border-[#DCFCE7]/60 rounded-xl px-3.5 py-2 flex items-center gap-2"
          >
            <svg
              class="w-4 h-4 text-emerald-600 shrink-0"
              viewBox="0 0 16 16"
              fill="none"
            >
              <circle
                cx="8"
                cy="8"
                r="7"
                stroke="currentColor"
                stroke-width="1.25"></circle>
              <path
                d="M8 4.5V8.5"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"></path>
              <circle cx="8" cy="11.25" r="0.75" fill="currentColor"
              ></circle>
            </svg>
            <span class="text-xs text-emerald-800 font-normal">
              This GSTIN number has been verified against government records
              successfully!
            </span>
          </div>

          <!-- Line items -->
          <div class="pt-2">
            <p class="text-base font-bold text-slate-900 mb-2.5">
              Line items
            </p>
            <div class="space-y-2">
              <div
                class="bg-[#F6F7F9] rounded-xl px-3.5 py-2.5 flex items-center justify-between"
              >
                <span
                  id="val-item-1-name"
                  class="text-sm font-medium text-slate-800 inline-block will-change-transform"
                  >Galvanised steel sheet — 2 mm</span
                >
                <div class="flex items-center gap-6">
                  <span
                    id="val-item-1-qty"
                    class="text-sm text-slate-600 font-normal w-6 text-center inline-block will-change-transform"
                    >24</span
                  >
                  <span
                    class="bg-white border border-slate-200 rounded-lg px-3.5 py-1 text-sm font-medium text-slate-800 min-w-23.75 text-center"
                  >
                    <span id="val-item-1-amount" class="inline-block will-change-transform">₹22400.16</span>
                  </span>
                </div>
              </div>

              <div
                class="bg-[#F6F7F9] rounded-xl px-3.5 py-2.5 flex items-center justify-between"
              >
                <span
                  id="val-item-2-name"
                  class="text-sm font-medium text-slate-800 inline-block will-change-transform"
                  >Cutting and handling</span
                >
                <div class="flex items-center gap-6">
                  <span
                    id="val-item-2-qty"
                    class="text-sm text-slate-600 font-normal w-6 text-center inline-block will-change-transform"
                    >1</span
                  >
                  <span
                    class="bg-white border border-slate-200 rounded-lg px-3.5 py-1 text-sm font-medium text-slate-800 min-w-23.75 text-center"
                  >
                    <span id="val-item-2-amount" class="inline-block will-change-transform">₹1897.32</span>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Totals -->
          <div class="pt-2">
            <p class="text-base font-bold text-slate-900 mb-2.5">
              Totals
            </p>
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1"
                  >Subtotal</label
                >
                <div
                  class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800 font-medium"
                >
                  <span id="val-subtotal" class="inline-block will-change-transform">₹24297.48</span>
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1"
                  >GST</label
                >
                <div
                  class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800 font-medium"
                >
                  <span id="val-tax" class="inline-block will-change-transform">₹4500.00</span>
                </div>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-500 mb-1"
                  >Total</label
                >
                <div
                  class="w-full bg-white border-2 border-emerald-500 rounded-xl px-3 py-2 text-sm text-slate-800 font-medium"
                >
                  <span id="val-total" class="inline-block will-change-transform">₹28,797.48</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Total match alert -->
          <div
            class="bg-[#EFFFF3] border border-[#DCFCE7]/60 rounded-xl px-3.5 py-2 flex items-center gap-2"
          >
            <svg
              class="w-4 h-4 text-emerald-600 shrink-0"
              viewBox="0 0 16 16"
              fill="none"
            >
              <circle
                cx="8"
                cy="8"
                r="7"
                stroke="currentColor"
                stroke-width="1.25"></circle>
              <path
                d="M8 4.5V8.5"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linecap="round"></path>
              <circle cx="8" cy="11.25" r="0.75" fill="currentColor"
              ></circle>
            </svg>
            <span class="text-xs text-emerald-800 font-normal">
              This total matches the line items above!
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-full md:w-3/4 flex items-center justify-center px-6 sm:px-10 md:px-0 py-10 md:py-0">
    <div class="max-w-xl w-full md:pl-6 lg:pl-10">
      <div class="overflow-hidden w-fit rounded-full mb-3">
        <p class="extraction-badge primary-btn rounded-full w-fit px-4 py-0.5" style="opacity: 0; transform: translateY(120%);">
         EXTRACTION & VALIDATION
        </p>
      </div>

      <div class="mt-3">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold tracking-tight text-slate-900 leading-[1.14]">
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="extraction-word inline-block" style="opacity: 0; transform: translateY(130%);">ZERO</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="extraction-word inline-block" style="opacity: 0; transform: translateY(130%);">manual</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="extraction-word inline-block" style="opacity: 0; transform: translateY(130%);">data</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="extraction-word inline-block" style="opacity: 0; transform: translateY(130%);">entry.</span>
          </span>
          <br class="hidden sm:inline" />
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="extraction-word inline-block" style="opacity: 0; transform: translateY(130%);">&</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="extraction-word inline-block" style="opacity: 0; transform: translateY(130%);">Plain</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="extraction-word inline-block" style="opacity: 0; transform: translateY(130%);">Language</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 align-top">
            <span class="extraction-word inline-block" style="opacity: 0; transform: translateY(130%);">Validation.</span>
          </span>
        </h2>
      </div>
    </div>
  </div>
</section>

<style>
  .extraction-badge {
    transform: translateY(120%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .extraction-word {
    transform: translateY(130%);
    opacity: 0;
    will-change: transform, opacity;
  }

  :global(.pin-spacer:has(#extraction-section)) {
    z-index: 20 !important;
  }

  .scanner-card-container {
    --scan-progress: 0%;
  }

  .scanner-output-layer {
    clip-path: inset(0 0 calc(100% - var(--scan-progress, 0%)) 0);
    will-change: clip-path;
  }

  .scanner-input-layer {
    clip-path: inset(var(--scan-progress, 0%) 0 0 0);
    will-change: clip-path;
  }

  .scanner-laser-line {
    top: var(--scan-progress, 0%);
    transform: translateY(-50%);
    will-change: top, opacity;
  }

  .laser-beam-bar {
    height: 3.5px;
    background: linear-gradient(90deg, #059669 0%, #10B981 20%, #34D399 50%, #10B981 80%, #059669 100%);
    box-shadow: 0 0 8px #10B981, 0 0 16px rgba(52, 211, 153, 0.9), 0 0 28px rgba(16, 185, 129, 0.6);
    border-radius: 9999px;
  }

  .laser-glow-sheen {
    height: 40px;
    top: -18px;
    background: linear-gradient(180deg, rgba(16, 185, 129, 0) 0%, rgba(52, 211, 153, 0.28) 50%, rgba(16, 185, 129, 0) 100%);
  }

  /* Mobile: Show extracted details cleanly without clip-path, hide inactive laser beam */
  @media (max-width: 767px) {
    .scanner-output-layer {
      clip-path: none !important;
    }
    .scanner-laser-line {
      display: none !important;
    }
  }
</style>

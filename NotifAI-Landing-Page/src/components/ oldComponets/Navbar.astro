---
// Navbar component matching the NICO design
import { siteLinks } from "../config/links";
---

<header
  id="main-navbar"
  class="fixed top-0 left-0 right-0 z-50 w-full bg-[#374E65] border-b border-white/10 transition-transform duration-300"
>
  <div class="w-full px-6 sm:px-10 lg:px-14 h-14 sm:h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a
      href="/#hero-section"
      class="nav-link flex items-center select-none cursor-pointer"
    >
      <span
        class="text-base sm:text-lg font-bold tracking-wider text-white hover:text-white/90 transition-colors uppercase"
      >
        NICO
      </span>
    </a>

    <!-- Center Nav Links -->
    <nav
      class="hidden md:flex items-center gap-7 lg:gap-9 text-[13px] sm:text-sm font-normal text-white/80"
    >
      <a
        href="/#product"
        class="nav-link hover:text-white transition-colors py-1"
        >Product</a
      >
      <a
        href="/#solutions"
        class="nav-link hover:text-white transition-colors py-1"
        >Solutions</a
      >
      <a
        href="/#use-cases"
        class="nav-link hover:text-white transition-colors py-1"
        >Use Cases</a
      >
      <a
        href="/#integrations"
        class="nav-link hover:text-white transition-colors py-1"
        >Integrations</a
      >
      <a
        href="/#pricing-section"
        class="nav-link hover:text-white transition-colors py-1"
        >Pricing</a
      >
    </nav>

    <!-- Right Side Action -->
    <div class="hidden sm:flex items-center">
      <a
        href={siteLinks.navbar.getStarted}
        class="px-5 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-medium bg-white text-[#1E3A5F] hover:bg-slate-100 transition-all duration-200 shadow-xs active:scale-[0.98] select-none text-center cursor-pointer inline-flex items-center justify-center"
      >
        Get Started
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <div class="flex sm:hidden items-center gap-2">
      <a
        href={siteLinks.navbar.getStarted}
        class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-[#1E3A5F]"
      >
        Get Started
      </a>
      <button
        id="mobile-menu-toggle"
        class="nav-btn p-1.5 rounded-lg text-white hover:bg-white/10 transition-colors focus:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg
          id="menu-icon-open"
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu-dropdown"
    class="hidden sm:hidden px-6 pt-3 pb-6 border-t border-white/10 bg-[#374E65] flex flex-col gap-3 shadow-2xl"
  >
    <a
      href="/#product"
      class="nav-link mobile-link py-2 text-sm font-medium text-white/80 hover:text-white"
      >Product</a
    >
    <a
      href="/#solutions"
      class="nav-link mobile-link py-2 text-sm font-medium text-white/80 hover:text-white"
      >Solutions</a
    >
    <a
      href="/#use-cases"
      class="nav-link mobile-link py-2 text-sm font-medium text-white/80 hover:text-white"
      >Use Cases</a
    >
    <a
      href="/#integrations"
      class="nav-link mobile-link py-2 text-sm font-medium text-white/80 hover:text-white"
      >Integrations</a
    >
    <a
      href="/#pricing-section"
      class="nav-link mobile-link py-2 text-sm font-medium text-white/80 hover:text-white"
      >Pricing</a
    >
    <div class="pt-2">
      <a
        href={siteLinks.navbar.getStarted}
        class="w-full text-center block py-2.5 rounded-full text-sm font-medium bg-white text-[#1E3A5F] hover:bg-gray-100 transition-colors"
        >Get Started</a
      >
    </div>
  </div>
</header>

<style>
  #main-navbar {
    transition:
      transform 0.38s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease;
    will-change: transform;
  }

  #main-navbar.navbar--scrolled {
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.25);
  }

  #main-navbar.navbar--hidden {
    transform: translateY(-100%);
  }

  @media (hover: hover) and (pointer: fine) {
    #main-navbar.navbar--hidden:hover {
      transform: translateY(0);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollSmoother } from "gsap/ScrollSmoother";

  let scrollListenerAttached = false;
  let tickerCallback: (() => void) | null = null;

  function initNavbar() {
    const navbar = document.getElementById("main-navbar");
    const mobileMenu = document.getElementById("mobile-menu-dropdown");
    let isNavigating = false;

    function getScrollPos(): number {
      const smoother = ScrollSmoother.get();
      if (smoother) {
        return Math.max(0, smoother.scrollTop());
      }
      return Math.max(
        0,
        window.scrollY || document.documentElement.scrollTop || 0,
      );
    }

    let lastScrollY = getScrollPos();
    const SCROLL_DELTA_DOWN = 15;
    const SCROLL_DELTA_UP = 28;
    const TOP_THRESHOLD = 70;

    // Check initial scroll state
    if (getScrollPos() > 15) {
      navbar?.classList.add("navbar--scrolled");
    } else {
      navbar?.classList.remove("navbar--scrolled");
    }

    function handleScrollUpdate() {
      if (!navbar || isNavigating) return;

      // Prevent navbar from revealing during accordion animations or layout shifts
      if ((window as any).__accordionAnimating) {
        lastScrollY = getScrollPos();
        return;
      }

      const currentScrollY = getScrollPos();
      const diff = currentScrollY - lastScrollY;

      // Add radius and shadow when scrolled away from top; remove when back at top
      if (currentScrollY > 15) {
        navbar.classList.add("navbar--scrolled");
      } else {
        navbar.classList.remove("navbar--scrolled");
      }

      // Keep navbar visible if mobile dropdown menu is open
      const isMobileMenuOpen =
        mobileMenu && !mobileMenu.classList.contains("hidden");
      if (isMobileMenuOpen) {
        navbar.classList.remove("navbar--hidden");
        return;
      }

      // Prevent erratic behavior from overscroll / rubber-banding at bottom of page
      const maxScroll = Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight,
      );
      if (maxScroll > 0 && currentScrollY > maxScroll - 30) {
        lastScrollY = currentScrollY;
        return;
      }

      // Always show when near the very top of the page
      if (currentScrollY <= TOP_THRESHOLD) {
        navbar.classList.remove("navbar--hidden");
      } else if (diff > SCROLL_DELTA_DOWN) {
        // Scrolling down -> hide navbar (slide up)
        navbar.classList.add("navbar--hidden");
      } else if (diff < -SCROLL_DELTA_UP) {
        // Intentional upward scroll -> show navbar (slide down)
        navbar.classList.remove("navbar--hidden");
      }

      lastScrollY = currentScrollY;
    }

    // Only attach ticker when ScrollSmoother is actively running on desktop
    if (ScrollSmoother.get()) {
      if (tickerCallback) {
        gsap.ticker.remove(tickerCallback);
      }
      tickerCallback = handleScrollUpdate;
      gsap.ticker.add(tickerCallback);
    }

    // Window scroll listener
    if (!scrollListenerAttached) {
      window.addEventListener("scroll", handleScrollUpdate, { passive: true });
      scrollListenerAttached = true;
    }

    // Smooth scroll for nav links
    const links = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        const rawHref = link.getAttribute("href") || "";
        const isHomePage =
          window.location.pathname === "/" || window.location.pathname === "";

        let targetId = "";
        if (rawHref.startsWith("#")) {
          targetId = rawHref.substring(1);
        } else if (rawHref.startsWith("/#") && isHomePage) {
          targetId = rawHref.substring(2);
        }

        if (targetId && isHomePage) {
          let targetEl = document.getElementById(targetId);

          // Route logical names to existing sections
          if (!targetEl) {
            if (targetId === "product")
              targetEl = document.getElementById("classification-section");
            else if (targetId === "solutions")
              targetEl = document.getElementById("workflow-section");
            else if (targetId === "use-cases")
              targetEl =
                document.getElementById("engineered-section") ||
                document.getElementById("enterprise-scale-section");
            else if (targetId === "integrations")
              targetEl = document.getElementById("integration-section");
            else if (targetId === "pricing" || targetId === "pricing-section")
              targetEl = document.getElementById("pricing-section");
            else if (targetId === "sectors")
              targetEl = document.getElementById("classification-section");
            else if (targetId === "features")
              targetEl = document.getElementById("extraction-section");
            else if (targetId === "company")
              targetEl = document.getElementById("faq-section");
          }

          if (targetEl) {
            e.preventDefault();
            // Keep navbar visible during navigation scroll
            isNavigating = true;
            navbar?.classList.remove("navbar--hidden");

            const smoother = ScrollSmoother.get();
            if (smoother) {
              smoother.scrollTo(targetEl, true, "top top+=75");
            } else {
              targetEl.scrollIntoView({ behavior: "smooth" });
            }

            setTimeout(() => {
              isNavigating = false;
              lastScrollY = getScrollPos();
            }, 850);
          }
        }
      });
    });

    // Mobile menu toggle logic
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    if (toggleBtn && mobileMenu && iconOpen && iconClose) {
      toggleBtn.onclick = () => {
        const isHidden = mobileMenu.classList.contains("hidden");
        if (isHidden) {
          mobileMenu.classList.remove("hidden");
          iconOpen.classList.add("hidden");
          iconClose.classList.remove("hidden");
        } else {
          mobileMenu.classList.add("hidden");
          iconOpen.classList.remove("hidden");
          iconClose.classList.add("hidden");
        }
      };

      document.querySelectorAll(".mobile-link").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          iconOpen.classList.remove("hidden");
          iconClose.classList.add("hidden");
        });
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNavbar);
  } else {
    initNavbar();
  }
  document.addEventListener("astro:page-load", initNavbar);
</script>

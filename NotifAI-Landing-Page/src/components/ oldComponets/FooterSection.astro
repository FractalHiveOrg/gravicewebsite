---
import { siteLinks } from "../config/links";

interface Props {
  showCta?: boolean;
  animate?: boolean;
}

const { showCta = true, animate = true } = Astro.props;

const currentYear = new Date().getFullYear();

const footerLinks = {
  product: [
    { label: "AI Engine", href: "/#classification-section" },
    { label: "Security Features", href: "/#engineered-section" },
    { label: "Pricing Matrix", href: "/#pricing-section" },
  ],
  solutions: [
    { label: "Manufacturing POs", href: "/#classification-section" },
    { label: "Invoice Audits", href: "/#classification-section" },
    { label: "Logistics Manifests", href: "/#classification-section" },
    { label: "Services Invoicing", href: "/#classification-section" },
  ],
  integrations: [
    { label: "SAP Bridge", href: "/#integration-section" },
    { label: "Tally Prime ERP", href: "/#integration-section" },
    { label: "Zoho Books Hub", href: "/#integration-section" },
    { label: "Gmail & Outlook API", href: "/#integration-section" },
  ],
  company: [
    { label: "About Nico", href: "/#hero-section" },
    { label: "Press & Media", href: "/#hero-section" },
    { label: "Privacy Policy", href: siteLinks.legal.privacy },
  ],
};
---

<footer
  id="footer-section"
  class={`w-full bg-[#1E3A5F] text-white pt-16 md:pt-24 pb-12 px-4 sm:px-2 lg:px-1 ${showCta ? "min-h-screen" : ""}`}
>
  <div class="max-w-[90%] mx-auto flex flex-col items-center">
    {showCta && (
      <>
        <div
          class="footer-cta-card w-full bg-[#F5F2ED] rounded-3xl sm:rounded-[36px] p-8 sm:p-12 md:p-16 lg:p-20 shadow-xl border border-black/5 text-left mb-16 md:mb-20"
          style={animate ? "opacity: 0; transform: translateY(30px);" : "opacity: 1; transform: translateY(0);"}
        >
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-bold text-[#1A365D] tracking-tight leading-[1.15] max-w-2xl mb-8 md:mb-10"
      >
        <span
          class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top"
        >
          <span
            class="footer-word inline-block"
            style={animate ? "opacity: 0; transform: translateY(130%);" : "opacity: 1; transform: translateY(0);"}
            >Ready</span
          >
        </span>
        <span
          class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top"
        >
          <span
            class="footer-word inline-block"
            style={animate ? "opacity: 0; transform: translateY(130%);" : "opacity: 1; transform: translateY(0);"}
            >to</span
          >
        </span>
        <span
          class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top"
        >
          <span
            class="footer-word inline-block"
            style={animate ? "opacity: 0; transform: translateY(130%);" : "opacity: 1; transform: translateY(0);"}
            >eliminate</span
          >
        </span>
        <span
          class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top"
        >
          <span
            class="footer-word inline-block"
            style={animate ? "opacity: 0; transform: translateY(130%);" : "opacity: 1; transform: translateY(0);"}
            >manual</span
          >
        </span>
        <span
          class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-3 align-top"
        >
          <span
            class="footer-word inline-block"
            style={animate ? "opacity: 0; transform: translateY(130%);" : "opacity: 1; transform: translateY(0);"}
            >document</span
          >
        </span>
        <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 align-top">
          <span
            class="footer-word inline-block"
            style={animate ? "opacity: 0; transform: translateY(130%);" : "opacity: 1; transform: translateY(0);"}
            >processing?</span
          >
        </span>
      </h2>

      <div
        class="footer-cta-btns flex flex-wrap items-center gap-1"
        style={animate ? "opacity: 0; transform: translateY(20px);" : "opacity: 1; transform: translateY(0);"}
      >
        <a
          href={siteLinks.footer.startFree}
          class="md:px-7 px-3 py-3.5 rounded-full bg-[#1A365D] text-white font-semibold text-sm hover:bg-[#152B4A] transition-colors shadow-sm cursor-pointer"
        >
          Start Now
        </a>
        <a
          href={siteLinks.footer.bookDemo}
          class="md:px-7 px-3 py-3.5 rounded-full bg-transparent border border-[#1A365D] text-[#1A365D] font-semibold text-sm hover:bg-black/5 transition-colors cursor-pointer"
        >
          Book a Demo
        </a>
      </div>
    </div>

    <div class="w-full border-t border-white/15 mb-12 md:mb-16"></div>
  </>
)}

    <!-- Footer Links Grid -->
    <div
      class="w-full grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12 mb-16 text-left"
    >
      <!-- Product -->
      <div>
        <h3
          class="text-xs font-bold uppercase tracking-[0.14em] text-white/90 mb-4"
        >
          PRODUCT
        </h3>
        <ul class="space-y-2.5">
          {
            footerLinks.product.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs sm:text-[13px] text-white/70 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Solutions -->
      <div>
        <h3
          class="text-xs font-bold uppercase tracking-[0.14em] text-white/90 mb-4"
        >
          SOLUTIONS
        </h3>
        <ul class="space-y-2.5">
          {
            footerLinks.solutions.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs sm:text-[13px] text-white/70 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Integrations -->
      <div>
        <h3
          class="text-xs font-bold uppercase tracking-[0.14em] text-white/90 mb-4"
        >
          INTEGRATIONS
        </h3>
        <ul class="space-y-2.5">
          {
            footerLinks.integrations.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs sm:text-[13px] text-white/70 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3
          class="text-xs font-bold uppercase tracking-[0.14em] text-white/90 mb-4"
        >
          COMPANY
        </h3>
        <ul class="space-y-2.5">
          {
            footerLinks.company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs sm:text-[13px] text-white/70 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Legal / Copyright Row -->
    <div
      class="w-full flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] sm:text-xs text-white/60 pt-4"
    >
      <p>&copy; {currentYear} Fractal Hive. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href={siteLinks.legal.terms} class="hover:text-white transition-colors">
          Terms of Service
        </a>
        <a href={siteLinks.legal.privacy} class="hover:text-white transition-colors">
          Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-word {
    transform: translateY(130%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .footer-cta-card {
    transform: translateY(30px);
    opacity: 0;
    will-change: transform, opacity;
  }

  .footer-cta-btns {
    transform: translateY(20px);
    opacity: 0;
    will-change: transform, opacity;
  }
</style>

---
import { Image } from "astro:assets";
import bgImage from "../assets/images/images.jpeg";

const industries = [
  {
    id: "manufacturing",
    title: "Manufacturing",
    description:
      "Automate complex purchase orders, bills of lading, and material test reports directly into ERP workflows with zero manual overhead.",
  },
  {
    id: "finance",
    title: "Finance & Accounting",
    description:
      "Reconcile multi-currency invoices, tax receipts, and vendor statements with automated two-way matching and ledger posting.",
  },
  {
    id: "logistics",
    title: "Logistics",
    description:
      "Parse multimodal airway bills, ocean manifests, customs entries, and freight audit notes automatically at high volume.",
  },
];
---

<section
  id="engineering-section"
  class="engineering-section w-full md:min-h-screen bg-white flex flex-col lg:flex-row justify-start lg:justify-center items-center px-6 lg:px-12 py-16 lg:py-0 section-bg-dot relative"
>
  <!-- Left Column: Title -->
  <div class="w-full lg:w-1/2 flex items-center justify-center lg:justify-end lg:pr-12 xl:pr-16 mb-10 lg:mb-0">
    <div class="max-w-lg w-full">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.12] text-slate-900 tracking-tight">
        <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
          <span class="engineering-word inline-block" style="opacity: 0; transform: translateY(130%);">Engineered</span>
        </span>
        <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
          <span class="engineering-word inline-block" style="opacity: 0; transform: translateY(130%);">for</span>
        </span>
        <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
          <span class="engineering-word inline-block" style="opacity: 0; transform: translateY(130%);">document</span>
        </span>
        <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
          <span class="engineering-word inline-block" style="opacity: 0; transform: translateY(130%);">heavy</span>
        </span>
        <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 align-top">
          <span class="engineering-word inline-block" style="opacity: 0; transform: translateY(130%);">industries</span>
        </span>
      </h2>
    </div>
  </div>

  <!-- Right Column: Accordion -->
  <div class="w-full lg:w-1/2 flex items-center justify-center lg:justify-start lg:pl-6 xl:pl-10">
    <div
      id="engineering-accordion"
      class="w-full max-w-md lg:max-w-lg xl:max-w-xl h-auto lg:h-[520px] flex flex-col gap-3.5 select-none"
      style="opacity: 0; transform: translateY(40px);"
    >
      {
        industries.map((item, index) => (
          <div
            class="accordion-card relative w-full rounded-2xl sm:rounded-3xl p-5 sm:px-6 sm:py-4 cursor-pointer overflow-hidden is-inactive border border-white/10"
            data-index={index}
            role="region"
            aria-expanded="false"
            tabindex="0"
            style="flex-grow: 1; flex-basis: 0%;"
          >
            <!-- Background Image Layer with Zoom Effect -->
            <div class="card-bg-layer absolute inset-0 overflow-hidden pointer-events-none rounded-2xl sm:rounded-3xl">
              <Image
                src={bgImage}
                alt=""
                width={800}
                format="webp"
                quality={80}
                class="card-bg-img w-full h-full object-cover will-change-transform"
                loading="lazy"
              />
              <div class="card-bg-overlay absolute inset-0 bg-gradient-to-br from-slate-950/90 via-slate-950/82 to-slate-900/78"></div>
            </div>

            <div class="card-inner relative z-10 flex flex-col justify-center h-full w-full">
              <!-- Header Row: Industry Name & Indicator -->
              <div class="card-header flex items-center justify-between w-full">
                <span class="card-title text-white font-semibold text-lg sm:text-xl tracking-tight transition-transform">
                  {item.title}
                </span>
                <div class="card-icon-wrap w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-white/70 shrink-0">
                  <svg class="card-chevron w-4 h-4 will-change-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>

              <!-- Expanded Content (Description) with dedicated inner wrapper for smooth height animation -->
              <div
                class="card-expanded-content overflow-hidden will-change-[height,opacity]"
                style="height: 0px; opacity: 0;"
              >
                <div class="card-expanded-inner pt-3 pb-1">
                  <p class="text-slate-300 text-sm sm:text-[15px] leading-relaxed max-w-lg">
                    {item.description}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
  
<style>
  .engineering-word {
    transform: translateY(130%);
    opacity: 0;
    will-change: transform, opacity;
  }

  #engineering-accordion {
    will-change: transform, opacity;
  }

  .accordion-card {
    position: relative;
    background-color: #0b1120;
    outline: none;
    box-shadow: 0 4px 18px -2px rgba(0, 0, 0, 0.28);
    transform: translateZ(0);
    will-change: flex-grow;
    flex-basis: 0%;
    min-height: 56px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  @media (max-width: 1023px) {
    .accordion-card {
      flex-basis: auto !important;
      height: auto !important;
      min-height: 64px;
    }
  }

  .accordion-card:focus-visible {
    box-shadow: 0 0 0 2px #38bdf8;
  }

  .accordion-card.is-active {
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 12px 36px -4px rgba(6, 182, 212, 0.2), 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .accordion-card.is-inactive:hover {
    border-color: rgba(255, 255, 255, 0.25);
  }

  .card-bg-img {
    transform-origin: center center;
  }

  .card-inner {
    height: 100%;
    width: 100%;
  }
</style>

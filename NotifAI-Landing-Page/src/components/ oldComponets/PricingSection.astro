---
import { siteLinks } from "../config/links";
---

<section
  id="pricing-section"
  class="pricing-section w-full md:min-h-screen py-24 px-6 md:px-12 flex flex-col justify-center items-center section-bg relative z-20 section-bg-dot"
>
  <div class="w-full max-w-5xl mx-auto">
    <!-- Section Title -->
    <h2
      class="text-3xl sm:text-4xl md:text-[42px] font-bold text-slate-900 tracking-tight mb-10 md:mb-14 text-center"
    >
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-2.5 align-top">
        <span class="pricing-word inline-block" style="opacity: 0; transform: translateY(130%);">Transparent</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-2.5 align-top">
        <span class="pricing-word inline-block" style="opacity: 0; transform: translateY(130%);">plans</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-2.5 align-top">
        <span class="pricing-word inline-block" style="opacity: 0; transform: translateY(130%);">designed</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2 sm:mr-2.5 align-top">
        <span class="pricing-word inline-block" style="opacity: 0; transform: translateY(130%);">to</span>
      </span>
      <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 align-top">
        <span class="pricing-word inline-block" style="opacity: 0; transform: translateY(130%);">scale</span>
      </span>
    </h2>

    <!-- Pricing Cards Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-7 items-center justify-center"
    >
      <!-- Standard Plan -->
      <div class="pricing-card-col flex flex-col justify-center h-full w-full" style="opacity: 0; transform: translateY(40px);">
        <div
          class="bg-white h-full min-h-[480px] rounded-[28px] p-7 sm:p-8 flex flex-col justify-between border border-black/[0.03] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 w-full"
        >
          <div>
            <!-- Plan Name -->
            <p
              class="text-[11px] font-bold tracking-[0.14em] text-slate-400 uppercase mb-3"
            >
              STANDARD
            </p>

            <!-- Price -->
            <div class="flex items-baseline gap-1.5">
              <span class="text-3xl sm:text-[34px] font-bold text-slate-900 tracking-tight">
                INR 0
              </span>
              <span class="text-xs sm:text-[13px] font-normal text-slate-500">
                / Forever
              </span>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-[13px] text-slate-500 leading-relaxed mt-2 mb-8">
              Manual uploads and exports for small operations.
            </p>

            <!-- Features List -->
            <ul class="space-y-3.5 mb-10">
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-700 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-[#E87A3E] shrink-0"></span>
                <span>Manual document upload</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-700 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-[#E87A3E] shrink-0"></span>
                <span>Excel/JSON export</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-700 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-[#E87A3E] shrink-0"></span>
                <span>Monthly credit pool</span>
              </li>
            </ul>
          </div>

          <!-- CTA Button -->
          <div>
            <a
              href={siteLinks.pricing.starter}
              class="block w-full py-3 px-6 rounded-full border border-slate-900/80 text-slate-900 font-semibold text-xs sm:text-[13px] text-center hover:bg-black/5 transition-all duration-200 cursor-pointer"
            >
              Get Started Free
            </a>
          </div>
        </div>
      </div>

      <!-- Pro Plan (Most Popular) -->
      <div class="pricing-card-col flex flex-col justify-center h-full w-full" style="opacity: 0; transform: translateY(40px);">
        <div
          class="bg-[#DCE5FC] rounded-[28px] p-7 sm:p-9 flex flex-col justify-between border border-blue-200/50 shadow-md md:scale-[1.03] z-10 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 w-full"
        >
          <div>
            <!-- Plan Name & Badge -->
            <div class="flex items-center justify-between mb-3">
              <p
                class="text-[11px] font-bold tracking-[0.14em] text-slate-500 uppercase"
              >
                PRO
              </p>
              <span
                class="bg-[#172554] text-white text-[9px] font-bold tracking-wider px-2.5 py-1 rounded-full uppercase"
              >
                MOST POPULAR
              </span>
            </div>

            <!-- Price -->
            <div class="flex items-baseline gap-1.5">
              <span class="text-3xl sm:text-[34px] font-bold text-slate-900 tracking-tight">
                INR 249
              </span>
              <span class="text-xs sm:text-[13px] font-normal text-slate-600">
                / month
              </span>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed mt-2 mb-8">
              Full end-to-end automation with ERP sync.
            </p>

            <!-- Features List -->
            <ul class="space-y-3.5 mb-10">
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-800 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-slate-900 shrink-0"></span>
                <span>Everything in Standard</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-800 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-slate-900 shrink-0"></span>
                <span>Mailbox &amp; ERP sync</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-800 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-slate-900 shrink-0"></span>
                <span>Automatic push to Tally/Zoho</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-800 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-slate-900 shrink-0"></span>
                <span>Grouped folders</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-800 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-slate-900 shrink-0"></span>
                <span>Advanced rules</span>
              </li>
            </ul>
          </div>

          <!-- CTA Button -->
          <div>
            <a
              href={siteLinks.pricing.pro}
              class="block w-full py-3 px-6 rounded-full bg-[#1E3A5F] text-white font-semibold text-xs sm:text-[13px] text-center shadow-md hover:bg-[#152B47] transition-all duration-200 cursor-pointer"
            >
              Upgrade to Pro
            </a>
          </div>
        </div>
      </div>

      <!-- Enterprise Plan -->
      <div class="pricing-card-col flex flex-col justify-center h-full w-full" style="opacity: 0; transform: translateY(40px);">
        <div
          class="bg-white h-full min-h-[480px] rounded-[28px] p-7 sm:p-8 flex flex-col justify-between border border-black/[0.03] transition-all duration-300 hover:shadow-lg hover:-translate-y-1 w-full"
        >
          <div>
            <!-- Plan Name -->
            <p
              class="text-[11px] font-bold tracking-[0.14em] text-slate-400 uppercase mb-3"
            >
              ENTERPRISE
            </p>

            <!-- Price -->
            <div class="flex items-baseline gap-1.5">
              <span class="text-3xl sm:text-[34px] font-bold text-slate-900 tracking-tight">
                Custom
              </span>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-[13px] text-slate-500 leading-relaxed mt-2 mb-8">
              Tailored volume, custom SLAs, and on-prem connectors.
            </p>

            <!-- Features List -->
            <ul class="space-y-3.5 mb-10">
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-700 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-[#E87A3E] shrink-0"></span>
                <span>Custom integrations</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-700 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-[#E87A3E] shrink-0"></span>
                <span>Dedicated SLA</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-700 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-[#E87A3E] shrink-0"></span>
                <span>Volume discounts</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs sm:text-[13px] text-slate-700 font-medium">
                <span class="w-1.5 h-1.5 rounded-[1.5px] bg-[#E87A3E] shrink-0"></span>
                <span>SOC2 Type II audit report</span>
              </li>
            </ul>
          </div>

          <!-- CTA Button -->
          <div>
            <a
              href={siteLinks.pricing.enterprise}
              class="block w-full py-3 px-6 rounded-full border border-slate-900/80 text-slate-900 font-semibold text-xs sm:text-[13px] text-center hover:bg-black/5 transition-all duration-200 cursor-pointer"
            >
              Contact Sales
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-word {
    transform: translateY(130%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .pricing-card-col {
    will-change: transform, opacity;
  }
</style>

---
---

<section
  id="integration-section"
  class="integration-section w-full md:min-h-screen section-bg flex flex-col md:flex-row justify-center items-center relative z-10 section-bg-dot py-16 md:py-0"
>
  <div class="w-full md:w-1/2 flex items-center justify-center md:shrink-0 px-6 sm:px-10 md:px-0 mb-8 md:mb-0">
    <div class="md:pl-10 lg:pl-16 xl:pl-22 pr-4 max-w-xl w-full">
      <div class="overflow-hidden w-fit rounded-full mb-3">
        <p class="integration-badge primary-btn rounded-full w-fit px-4 py-0.5" style="opacity: 0; transform: translateY(120%);">
          DOWNSTREAM INTEGRATIONS
        </p>
      </div>

      <div class="mt-3">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold tracking-tight text-slate-900 leading-[1.14]">
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="integration-word inline-block" style="opacity: 0; transform: translateY(130%);">Push</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="integration-word inline-block" style="opacity: 0; transform: translateY(130%);">verified</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="integration-word inline-block" style="opacity: 0; transform: translateY(130%);">data</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="integration-word inline-block" style="opacity: 0; transform: translateY(130%);">directly</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="integration-word inline-block" style="opacity: 0; transform: translateY(130%);">into</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top">
            <span class="integration-word inline-block" style="opacity: 0; transform: translateY(130%);">your</span>
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 align-top">
            <span class="integration-word inline-block" style="opacity: 0; transform: translateY(130%);">ledgers</span>
          </span>
        </h2>
      </div>
    </div>
  </div>
  <div class="w-full md:w-1/2 flex justify-center items-center p-4 sm:p-4 md:p-6 md:shrink-0">
    <!-- Horizontal scroll wrapper on mobile only -->
    <div class="w-full overflow-x-auto md:overflow-visible">
    <!-- Main Accounting / Tally Prime Window Card -->
    <div
      class="bg-white rounded-2xl md:rounded-3xl shadow-2xl border border-slate-300/80 w-full min-w-[540px] md:min-w-0 max-w-2xl xl:max-w-3xl overflow-hidden flex flex-col select-none text-[11px] font-sans"
    >
      <!-- 1. Top Tally Prime Header Bar (Dark Teal) -->
      <div
        class="bg-[#12383b] text-white px-3 sm:px-4 py-1.5 flex items-center justify-between text-[10px] sm:text-[11px] font-medium shrink-0 border-b border-[#0d2a2c] relative"
      >
        <!-- Left Menu Items -->
        <div class="flex items-center gap-3 sm:gap-4 shrink-0 text-slate-200">
          <span class="hover:text-white cursor-default">Company</span>
          <span class="hover:text-white cursor-default">Master Data</span>
          <span class="hover:text-white cursor-default">Exchange</span>
        </div>


        <!-- Right Menu Items & Controls -->
        <div class="flex items-center gap-2.5 sm:gap-3 text-slate-200 shrink-0">
          <span class="hover:text-white cursor-default hidden md:inline">Import</span>
          <span class="hover:text-white cursor-default hidden md:inline">Export</span>
          <span class="hover:text-white cursor-default hidden lg:inline">Share</span>
          <span class="hover:text-white cursor-default hidden lg:inline">Print</span>
          <span class="hover:text-white cursor-default">Help</span>

          <!-- Notification Bell -->
          <div class="relative cursor-default ml-1">
            <svg class="w-3.5 h-3.5 text-slate-200" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
              ></path>
            </svg>
            <span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 bg-red-500 rounded-full"></span>
          </div>

          <!-- Window Controls -->
          <div class="flex items-center gap-1.5 ml-1 text-slate-300">
            <span class="cursor-default hover:text-white text-xs leading-none">-</span>
            <span class="cursor-default hover:text-white text-[10px] leading-none">□</span>
            <span class="cursor-default hover:text-white text-xs leading-none">✕</span>
          </div>
        </div>
      </div>

      <!-- 2. Main Window Body (Voucher Area + Right Sidebar) -->
      <div class="flex flex-row flex-1 min-w-0 bg-[#fafcfe] overflow-hidden">
        <!-- Left: Voucher Area -->
        <div class="flex-1 flex flex-col min-w-0 justify-between">
          <!-- Sky Blue Sub-Header Bar -->
          <div
            class="bg-[#9bd7f5] border-b border-[#80c7eb] px-3 sm:px-4 py-1 flex items-center justify-between text-slate-900 font-bold text-[10.5px] sm:text-xs shrink-0"
          >
            <span>Accounting Voucher (Purchase)</span>
            <span class="pr-2 sm:pr-8">Demo Trading Company</span>
          </div>

          <!-- Voucher Content Body -->
          <div class="p-3 sm:p-4 flex flex-col flex-1">
            <!-- Row 1: Purchase Badge + No. 25 & Date Box -->
            <div class="flex items-start justify-between">
              <div class="flex items-center gap-3">
                <span
                  class="bg-[#2563eb] text-white font-bold px-2.5 py-0.5 rounded text-[10.5px] sm:text-xs tracking-wide"
                  >Purchase</span
                >
                <span class="text-slate-900 font-semibold text-[10.5px] sm:text-xs"
                  >No. &nbsp; 25</span
                >
              </div>
              <!-- Date Box -->
              <div
                class="bg-[#fef9c3] border border-[#fde047] px-3 py-0.5 text-right rounded-xs leading-tight min-h-[30px]"
              >
                <div class="font-bold text-slate-900 text-[10.5px] sm:text-xs">
                  <span id="target-invoice-date" class="tally-field-value opacity-0">08-Sep-2026</span>
                </div>
                <div class="text-[9.5px] text-slate-600">Tuesday</div>
              </div>
            </div>

            <!-- Supplier & Ledger Info Rows -->
            <div class="mt-2 space-y-0.5 text-[10px] sm:text-[11px] text-slate-800">
              <div class="flex items-center min-h-4.5">
                <span class="w-32 sm:w-36 text-slate-700 shrink-0">Supplier Invoice No.</span>
                <span class="mr-2">:</span>
                <span
                  id="target-invoice-no"
                  class="tally-field-value opacity-0 font-semibold text-slate-900"
                  >INV-2026-1847</span
                >
                <span class="ml-6 sm:ml-12 text-slate-700 shrink-0">Date</span>
                <span class="mx-2">:</span>
                <span
                  class="tally-field-value opacity-0 text-slate-900"
                  >08-Sep-2026</span
                >
              </div>
              <div class="flex items-center flex-wrap min-h-4.5">
                <span class="w-32 sm:w-36 text-slate-700 shrink-0">Party (Supplier)</span>
                <span class="mr-2">:</span>
                <span
                  id="target-supplier"
                  class="tally-field-value opacity-0 font-bold text-slate-900"
                  >Acme Metals Ltd.</span
                >
                <span class="ml-4 sm:ml-8 text-[9.5px] sm:text-[10px] text-slate-600 flex items-center gap-1">
                  <span class="text-slate-500 font-medium">GSTIN/UIN:</span>
                  <span
                    id="target-gstin"
                    class="tally-field-value opacity-0 font-mono font-bold text-slate-800 tracking-wider"
                    >GST12345678IN90</span
                  >
                </span>
              </div>
              <div class="flex items-center text-slate-500 italic text-[9.5px] sm:text-[10px]">
                <span class="w-32 sm:w-36 shrink-0">Current balance</span>
                <span class="mr-2 not-italic">:</span>
                <span>12,34,567.89 Dr</span>
              </div>
              <div class="flex items-center min-h-[18px]">
                <span class="w-32 sm:w-36 text-slate-700 shrink-0">Purchase ledger</span>
                <span class="mr-2">:</span>
                <span class="font-bold text-slate-900">Purchases</span>
              </div>
              <div class="flex items-center text-slate-500 italic text-[9.5px] sm:text-[10px]">
                <span class="w-32 sm:w-36 shrink-0">Current balance</span>
                <span class="mr-2 not-italic">:</span>
                <span>45,67,890.12 Dr</span>
              </div>
            </div>

            <!-- Items Table -->
            <div class="mt-3 flex-1 flex flex-col">
              <!-- Table Header -->
              <div
                class="border-y border-slate-300 py-1 grid grid-cols-12 text-[10.5px] sm:text-[11px] font-bold text-slate-900"
              >
                <div class="col-span-5 sm:col-span-6">Name of Item</div>
                <div class="col-span-2 text-right">Quantity</div>
                <div class="col-span-2 text-right">
                  Rate <span class="font-normal italic text-[9px]">per</span>
                </div>
                <div class="col-span-3 sm:col-span-2 text-right">Amount</div>
              </div>

              <!-- Table Rows -->
              <div class="space-y-1.5 py-1.5 text-[10.5px] sm:text-[11px] text-slate-800">
                <!-- Item 1 -->
                <div class="grid grid-cols-12 items-baseline min-h-[18px]">
                  <div class="col-span-5 sm:col-span-6 font-bold text-slate-900">
                    <span id="target-item-1-name" class="tally-field-value opacity-0">Galvanised steel sheet — 2 mm</span>
                  </div>
                  <div class="col-span-2 text-right font-mono tabular-nums">
                    <span id="target-item-1-qty" class="tally-field-value opacity-0">24 nos</span>
                  </div>
                  <div class="col-span-2 text-right font-mono tabular-nums">
                    <span class="tally-field-value opacity-0">933.34 nos</span>
                  </div>
                  <div class="col-span-3 sm:col-span-2 text-right font-mono tabular-nums font-medium">
                    <span id="target-item-1-amount" class="tally-field-value opacity-0">22,400.16</span>
                  </div>
                </div>

                <!-- Item 2 -->
                <div class="grid grid-cols-12 items-baseline min-h-[18px]">
                  <div class="col-span-5 sm:col-span-6 font-bold text-slate-900">
                    <span id="target-item-2-name" class="tally-field-value opacity-0">Cutting and handling</span>
                  </div>
                  <div class="col-span-2 text-right font-mono tabular-nums">
                    <span id="target-item-2-qty" class="tally-field-value opacity-0">1 nos</span>
                  </div>
                  <div class="col-span-2 text-right font-mono tabular-nums">
                    <span class="tally-field-value opacity-0">1,897.32 nos</span>
                  </div>
                  <div class="col-span-3 sm:col-span-2 text-right font-mono tabular-nums font-medium">
                    <span id="target-item-2-amount" class="tally-field-value opacity-0">1,897.32</span>
                  </div>
                </div>
              </div>

              <!-- Subtotal Line -->
              <div class="grid grid-cols-12 pt-1 text-[10.5px] sm:text-[11px] min-h-[22px]">
                <div class="col-span-9 sm:col-span-10 text-right pr-3 text-slate-500 font-medium">
                  Subtotal
                </div>
                <div class="col-span-3 sm:col-span-2 text-right font-bold text-slate-900 font-mono tabular-nums border-t border-slate-400 pt-0.5">
                  <span id="target-subtotal" class="tally-field-value opacity-0">24,297.48</span>
                </div>
              </div>

              <!-- Blank Canvas Spacer (Tally style) -->
              <div class="flex-1 min-h-6 sm:min-h-10"></div>

              <!-- Narration & Summary Totals -->
              <div
                class="pt-2 flex items-center justify-between text-[10.5px] sm:text-[11px]"
              >
                <div class="font-bold text-slate-800">
                  Narration:
                </div>
                <div
                  class="flex items-center gap-6 sm:gap-10 border-y border-slate-400 py-0.5 text-right font-bold text-slate-900 font-mono tabular-nums min-h-[24px]"
                >
                  <span
                    id="target-total-qty"
                    class="tally-field-value opacity-0"
                    >25 nos</span
                  >
                  <span
                    id="target-total"
                    class="tally-field-value opacity-0"
                    >28,797.48</span
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Action Buttons Bar -->
          <div
            class="bg-[#c2e8fa] border-t border-[#9ad2f0] grid grid-cols-6 text-[9.5px] sm:text-[10px] font-semibold text-[#0284c7] divide-x divide-[#ade0f7] text-center"
          >
            <div class="py-1 px-1 cursor-default hover:bg-[#b0e0f8] transition-colors">
              <span class="underline">Q</span>: Quit
            </div>
            <div class="py-1 px-1"></div>
            <div class="py-1 px-1 cursor-default hover:bg-[#b0e0f8] transition-colors">
              <span class="underline">A</span>: Accept
            </div>
            <div class="py-1 px-1"></div>
            <div class="py-1 px-1 cursor-default hover:bg-[#b0e0f8] transition-colors">
              <span class="underline">D</span>: Delete
            </div>
            <div class="py-1 px-1 cursor-default hover:bg-[#b0e0f8] transition-colors">
              <span class="underline">X</span>: Cancel Voucher
            </div>
          </div>
        </div>

        <!-- Right: Tally Prime Function Keys Sidebar -->
        <div
          class="w-32 sm:w-34 lg:w-32 bg-[#dff2fd] border-l border-[#bde2f6] flex flex-col justify-between p-1.5 shrink-0 text-[9.5px] sm:text-[10px] select-none"
        >
          <!-- Top Group + Search -->
          <div>
            <!-- Search menu input -->
            <div
              class="bg-white border border-[#bfe2f7] rounded px-2 py-0.5 text-slate-400 text-[9.5px] sm:text-[10px] mb-1.5 flex items-center justify-between shadow-xs"
            >
              <span>Search menu (F3)</span>
            </div>

            <!-- Group 1: Date & Company -->
            <div class="space-y-0.5">
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F2: Date</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F3: Company</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
            </div>

            <!-- Group 2: Vouchers -->
            <div class="space-y-0.5 mt-2">
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F4: Contra</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F5: Payment</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F6: Receipt</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F7: Journal</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F8: Sales</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F9: Purchase</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span>F10: Other Vouchers</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
            </div>

            <!-- Group 3: Details & Reports -->
            <div class="space-y-0.5 mt-2">
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span><span class="underline">E</span>: Autofill</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span><span class="underline">H</span>: Change Mode</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span><span class="underline font-bold">I</span>: More Details</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span><span class="underline">Q</span>: Related Reports</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
            </div>

            <!-- Group 4: Optional & Post-Dated -->
            <div class="space-y-0.5 mt-2">
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span><span class="underline">L</span>: Optional</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
              <div
                class="bg-white hover:bg-sky-50 text-[#0284c7] border border-[#cae5f8] rounded px-2 py-0.5 flex items-center justify-between cursor-default transition-colors shadow-xs"
              >
                <span><span class="underline">T</span>: Post-Dated</span>
                <span class="text-[#60a5fa] font-bold text-xs leading-none">></span>
              </div>
            </div>
          </div>

          <!-- Bottom: F12 Configure -->
          <div
            class="pt-2 text-[#0284c7] font-semibold px-1 cursor-default hover:underline text-[9.5px] sm:text-[10px]"
          >
            F12: Configure
          </div>
        </div>
      </div>
    </div><!-- end tally-card -->
    </div><!-- end horizontal scroll wrapper -->
  </div><!-- end right column -->
</section>



<style>
  .integration-badge {
    transform: translateY(120%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .integration-word {
    transform: translateY(130%);
    opacity: 0;
    will-change: transform, opacity;
  }

  /* On mobile: show tally values immediately (no fly-in animation) */
  @media (max-width: 767px) {
    .tally-field-value {
      opacity: 1 !important;
    }
  }
</style>

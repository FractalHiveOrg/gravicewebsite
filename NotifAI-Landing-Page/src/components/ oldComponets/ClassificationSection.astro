---
import { Image } from "astro:assets";
import receiptImg from "../assets/images/sample-receipt-RCT-2026-1847-538x676@2x.png";
import invoiceImg from "../assets/images/sample-invoice-INV-2026-1847-538x676@2x.png";
import shippingImg from "../assets/images/sample-shipping-note-SHP-2026-1847-538x676@2x.png";
---

<section
  id="classification-section"
  class="classification-section w-full md:min-h-screen section-bg flex flex-col md:flex-row justify-center items-center relative section-bg-dot py-16 md:py-0"
>
  <!-- Text Column -->
  <div
    class="w-full md:w-1/2 flex items-center justify-center relative z-30 md:shrink-0 px-6 sm:px-10 md:px-0 mb-8 md:mb-0"
  >
    <div class="md:pl-10 lg:pl-16 xl:pl-22 max-w-xl w-full">
      <div class="overflow-hidden w-fit rounded-full mb-3">
        <p
          class="classification-badge primary-btn rounded-full w-fit px-4 py-0.5"
          style="opacity: 0; transform: translateY(120%);"
        >
          CLASSIFICATION
        </p>
      </div>

      <div class="mt-3">
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold tracking-tight text-slate-900 leading-[1.14]"
        >
          <span
            class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top"
          >
            <span
              class="classification-word inline-block"
              style="opacity: 0; transform: translateY(130%);">Instant</span
            >
          </span>
          <span
            class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top"
          >
            <span
              class="classification-word inline-block"
              style="opacity: 0; transform: translateY(130%);"
              >classification</span
            >
          </span>
          <span
            class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top"
          >
            <span
              class="classification-word inline-block"
              style="opacity: 0; transform: translateY(130%);">across</span
            >
          </span>
          <span
            class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top"
          >
            <span
              class="classification-word inline-block"
              style="opacity: 0; transform: translateY(130%);">every</span
            >
          </span>
          <span
            class="inline-block overflow-hidden pb-1.5 -mb-1.5 mr-2.5 sm:mr-3.5 align-top"
          >
            <span
              class="classification-word inline-block"
              style="opacity: 0; transform: translateY(130%);">document</span
            >
          </span>
          <span class="inline-block overflow-hidden pb-1.5 -mb-1.5 align-top">
            <span
              class="classification-word inline-block"
              style="opacity: 0; transform: translateY(130%);">stream</span
            >
          </span>
        </h2>
      </div>
    </div>
  </div>

  <!-- Card Column -->
  <div
    class="w-full md:w-1/2 flex justify-center items-center relative z-30 md:shrink-0 px-4 sm:px-6 md:px-4"
  >
    <div
      class="intelligence-card relative z-30 bg-white rounded-3xl w-full max-w-md md:max-w-2xl p-4 sm:p-5 md:p-6 shadow-sm border border-slate-100 flex flex-col justify-between"
      style="height: clamp(280px, 50vw, 420px); z-index: 30;"
    >
      <!-- Cards Landing Target Zone behind this card -->
      <div
        class="cards-landing-target absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-48 pointer-events-none opacity-0"
      >
      </div>

      <p
        class="text-base sm:text-lg md:text-xl font-bold text-slate-900 tracking-tight shrink-0"
      >
        Nico Intelligence
      </p>

      <div
        class="flex w-full flex-1 mt-3 gap-2.5 sm:gap-3.5 md:gap-4 overflow-x-auto md:overflow-visible min-h-0"
      >
        <!-- Column 1: PURCHASE ORDERS -->
        <div
          class="w-1/3 min-w-25 md:min-w-0 md:max-w-[33.333%] flex-1 h-full bg-[#EBDCFF] rounded-2xl sm:rounded-3xl p-2.5 sm:p-3 md:p-4 flex flex-col justify-between overflow-hidden shadow-sm relative z-10 shrink-0"
        >
          <div class="h-8 sm:h-10 md:h-12 flex items-center shrink-0">
            <h3
              class="font-extrabold text-[9px] sm:text-[11px] md:text-sm tracking-wide text-slate-900 uppercase leading-tight"
            >
              PURCHASE ORDERS
            </h3>
          </div>

          <!-- Document Card -->
          <div
            class="classification-doc-card w-[130%] md:w-[140%] flex-1 bg-white rounded-xl sm:rounded-2xl shadow-sm border border-black/5 overflow-hidden mobile-visible"
          >
            <Image
              src={receiptImg}
              alt="Sample Receipt RCT-2026-1847"
              width={480}
              format="webp"
              quality={80}
              class="w-full h-full object-cover object-top rounded-lg"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Column 2: INVOICES -->
        <div
          id="classification-invoice-column"
          class="invoice-column w-1/3 min-w-[100px] md:min-w-[33.333%] md:max-w-[33.333%] shrink-0 flex-1 h-full bg-[#D6E0FF] rounded-2xl sm:rounded-3xl p-2.5 sm:p-3 md:p-4 flex flex-col justify-between overflow-hidden shadow-sm relative z-20"
        >
          <div
            class="h-8 sm:h-10 md:h-12 flex items-center shrink-0 relative z-20"
          >
            <h3
              class="font-extrabold text-[9px] sm:text-[11px] md:text-sm tracking-wide text-slate-900 uppercase leading-tight"
            >
              INVOICES
            </h3>
          </div>

          <!-- Document Card -->
          <div
            id="classification-invoice-card"
            class="classification-invoice-card classification-doc-card relative w-[130%] md:w-[140%] flex-1 bg-white rounded-xl sm:rounded-2xl shadow-sm border border-black/5 overflow-hidden mobile-visible z-10"
          >
            <Image
              src={invoiceImg}
              alt="Sample Invoice INV-2026-1847"
              width={480}
              format="webp"
              quality={80}
              class="w-full h-full object-cover object-top rounded-lg"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Column 3: GRN -->
        <div
          class="w-1/3 min-w-[100px] md:min-w-0 md:max-w-[33.333%] flex-1 h-full bg-[#94C2B4] rounded-2xl sm:rounded-3xl p-2.5 sm:p-3 md:p-4 flex flex-col justify-between overflow-hidden shadow-sm relative z-30 shrink-0"
        >
          <div class="h-8 sm:h-10 md:h-12 flex items-center shrink-0">
            <h3
              class="font-extrabold text-[9px] sm:text-[11px] md:text-sm tracking-wide text-slate-900 uppercase leading-tight"
            >
              GRN
            </h3>
          </div>

          <!-- Document Card -->
          <div
            class="classification-doc-card w-[130%] md:w-[140%] flex-1 bg-white rounded-xl sm:rounded-2xl shadow-sm border border-black/5 overflow-hidden mobile-visible"
          >
            <Image
              src={shippingImg}
              alt="Sample Shipping Note SHP-2026-1847"
              width={480}
              format="webp"
              quality={80}
              class="w-full h-full object-cover object-top rounded-lg"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .classification-badge {
    transform: translateY(120%);
    opacity: 0;
    will-change: transform, opacity;
  }
  .classification-word {
    transform: translateY(130%);
    opacity: 0;
    will-change: transform, opacity;
  }

  /* On mobile: doc cards visible immediately (no animation required) */
  @media (max-width: 767px) {
    .classification-doc-card.mobile-visible {
      opacity: 1 !important;
    }
  }
</style>

---
// IntegrationsSection.astro - Native Integrations & Connectors Section
import IntegrationsHeader from "../integrations/IntegrationsHeader.astro";
import SourceConnectors from "../integrations/SourceConnectors.astro";
import DocumentScanner from "../integrations/DocumentScanner.astro";
import DestinationConnectors from "../integrations/DestinationConnectors.astro";
---

<section
  id="integrations-section"
  class="w-full py-16 sm:py-24 lg:py-28 px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center relative overflow-hidden"
>
  <div class="w-full max-w-310 mx-auto flex flex-col">
    <!-- ================= SECTION HEADER ================= -->
    <IntegrationsHeader />

    <!-- ================= MAIN VISUAL / CONNECTOR DIAGRAM ================= -->
    <div class="w-full relative flex items-center justify-center pt-8 pb-6 sm:pt-12 sm:pb-10">
      <div
        id="integrations-diagram"
        class="w-full flex items-center justify-center gap-0 max-w-5xl mx-auto overflow-x-auto lg:overflow-visible pt-10 sm:pt-12 pb-4 sm:pb-0"
      >
        <!-- Left 3 Source Icons & Animated Connector Sticks -->
        <SourceConnectors />

        <!-- Center Card: Scanner, Laser, Document & Extracted States -->
        <DocumentScanner />

        <!-- Right Animated Connector Sticks & 3 Destination Icons -->
        <DestinationConnectors />
      </div>
    </div>
  </div>
</section>

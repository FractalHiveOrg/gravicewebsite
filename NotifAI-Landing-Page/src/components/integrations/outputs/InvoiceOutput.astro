---
// InvoiceOutput.astro - AI Extracted Invoice Data & Validation Layer
---

<!-- OUTPUT: Invoice Extracted Fields -->
<div
  id="int-output-layer-invoice"
  class="int-output-layer absolute inset-0 w-full h-full overflow-y-auto z-20 opacity-0 bg-white p-4 sm:p-5 text-left"
  data-doc="invoice"
>
  <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100">
    <p class="text-sm sm:text-base font-bold text-slate-900">Extracted Invoice details</p>
    <!-- <span class="text-[10px] font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200/80 px-2 py-0.5 rounded-full">AI Extracted</span> -->
  </div>
  <div class="space-y-2">
    <div class="grid grid-cols-2 gap-2" data-field-row>
      <div>
        <label class="block text-[10px] font-medium text-slate-500 mb-0.5">Invoice number</label>
        <div class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 font-semibold font-mono">INV-2026-1847</div>
      </div>
      <div>
        <label class="block text-[10px] font-medium text-slate-500 mb-0.5">Invoice date</label>
        <div class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 font-semibold">8 September 2026</div>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-2" data-field-row>
      <div>
        <label class="block text-[10px] font-medium text-slate-500 mb-0.5">Supplier</label>
        <div class="w-full bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 font-semibold truncate">Acme Metals Ltd.</div>
      </div>
      <div>
        <label class="block text-[10px] font-medium text-slate-500 mb-0.5">GSTIN Number</label>
        <div class="w-full bg-white border border-emerald-500 rounded-lg px-2.5 py-1.5 text-xs text-slate-800 font-semibold font-mono">GST12345678IN90</div>
      </div>
    </div>
    <!-- Validation 1 -->
    <div id="inv-val-1" class="val-block">
      <div class="val-processing bg-amber-50 border border-amber-200/80 rounded-lg px-2.5 py-1.5 flex items-center gap-2">
        <div class="w-3.5 h-3.5 rounded-full bg-primary flex items-center justify-center shrink-0">
          <svg class="w-2.5 h-2.5 text-white animate-spin" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.8" />
            <path class="opacity-100" fill="currentColor" d="M12 3a9 9 0 0 1 9 9h-2.8a6.2 6.2 0 0 0-6.2-6.2V3z" />
          </svg>
        </div>
        <span class="text-[11px] text-amber-800 font-medium">Validating GSTIN against government registry...</span>
      </div>
      <div class="val-verified hidden bg-[#EFFFF3] border border-[#DCFCE7]/80 rounded-lg px-2.5 py-1.5 flex items-center gap-2">
        <div class="w-3.5 h-3.5 rounded-full bg-emerald-600 flex items-center justify-center shrink-0">
          <svg class="w-2 h-2 text-white" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.5 8.5l3 3 6-6" />
          </svg>
        </div>
        <span class="text-[11px] text-emerald-800 font-medium">GSTIN verified with government records successfully!</span>
      </div>
    </div>
    <div class="bg-[#F8F9FA] rounded-lg p-2 space-y-1" data-field-row>
      <div class="flex items-center justify-between text-xs font-medium text-slate-800">
        <span class="truncate pr-2">Galvanised steel sheet — 2 mm</span>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-slate-500 text-[11px]">24</span>
          <span class="bg-white border border-slate-200 rounded px-1.5 py-0.5 font-mono font-semibold text-[11px]">₹22,400.16</span>
        </div>
      </div>
      <div class="flex items-center justify-between text-xs font-medium text-slate-800">
        <span class="truncate pr-2">Cutting and handling</span>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-slate-500 text-[11px]">1</span>
          <span class="bg-white border border-slate-200 rounded px-1.5 py-0.5 font-mono font-semibold text-[11px]">₹1,897.32</span>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-3 gap-1.5" data-field-row>
      <div>
        <label class="block text-[10px] text-slate-400">Subtotal</label>
        <div class="w-full bg-slate-50 border border-slate-200 rounded-lg p-1.5 text-[11px] font-mono font-semibold text-slate-800">₹24,297.48</div>
      </div>
      <div>
        <label class="block text-[10px] text-slate-400">GST (18%)</label>
        <div class="w-full bg-slate-50 border border-slate-200 rounded-lg p-1.5 text-[11px] font-mono font-semibold text-slate-800">₹4,500.00</div>
      </div>
      <div>
        <label class="block text-[10px] text-slate-400">Total</label>
        <div class="w-full bg-white border border-emerald-500 rounded-lg p-1.5 text-[11px] font-mono font-bold text-slate-900">₹28,797.48</div>
      </div>
    </div>
    <!-- Validation 2 -->
    <div id="inv-val-2" class="val-block">
      <div class="val-processing bg-amber-50 border border-amber-200/80 rounded-lg px-2.5 py-1.5 flex items-center gap-2">
        <div class="w-3.5 h-3.5 rounded-full bg-primary flex items-center justify-center shrink-0">
          <svg class="w-2.5 h-2.5 text-white animate-spin" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.8" />
            <path class="opacity-100" fill="currentColor" d="M12 3a9 9 0 0 1 9 9h-2.8a6.2 6.2 0 0 0-6.2-6.2V3z" />
          </svg>
        </div>
        <span class="text-[11px] text-amber-800 font-medium">Auditing subtotal, taxes & mathematical parity...</span>
      </div>
      <div class="val-verified hidden bg-[#EFFFF3] border border-[#DCFCE7]/80 rounded-lg px-2.5 py-1.5 flex items-center gap-2">
        <div class="w-3.5 h-3.5 rounded-full bg-emerald-600 flex items-center justify-center shrink-0">
          <svg class="w-2 h-2 text-white" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.5 8.5l3 3 6-6" />
          </svg>
        </div>
        <span class="text-[11px] text-emerald-800 font-medium">Mathematically validated & matches line items!</span>
      </div>
    </div>
  </div>
</div>

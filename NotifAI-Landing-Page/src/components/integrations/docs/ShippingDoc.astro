---
// ShippingDoc.astro - HTML replica of Shipping note paper document
---

<!-- ── SHIPPING NOTE DOCUMENT NODE ── -->
<div
  id="int-input-layer-shipping"
  class="int-input-layer absolute inset-0 w-full h-full z-10 opacity-0 bg-white overflow-hidden"
  data-doc="shipping"
>
  <div class="p-4 sm:p-5 h-full flex flex-col font-sans text-slate-700 text-[10px] leading-snug">
    <!-- Header -->
    <div class="flex justify-between items-start mb-3 pb-2.5 border-b-2 border-slate-900">
      <div>
        <p class="text-[11px] font-black text-slate-900 uppercase tracking-tight">Acme Metals Ltd.</p>
        <p class="text-[9px] text-slate-400 mt-0.5">123 Industrial Estate, Mumbai — 400 001</p>
      </div>
      <div class="text-right">
        <p class="text-[16px] font-black text-slate-900 uppercase leading-tight">Shipping Note</p>
        <p class="text-[9px] text-slate-400 mt-1.5">No.&nbsp;<span data-highlight="shipment-no" class="font-bold font-mono text-slate-800">SHP-2026-1847</span></p>
        <p class="text-[9px] text-slate-400 mt-0.5">Date:&nbsp;<span data-highlight="date" class="font-semibold text-slate-700">9 Sep 2026</span></p>
      </div>
    </div>
    <!-- Consignee + Carrier -->
    <div class="grid grid-cols-2 gap-3 mb-3">
      <div>
        <p class="text-[8px] font-bold text-slate-400 uppercase tracking-widest mb-1">Consignee</p>
        <p class="text-[10px] font-bold text-slate-800"><span data-highlight="supplier">Sample Customer Pvt. Ltd.</span></p>
        <p class="text-[9px] text-slate-400">456 Business Park, Delhi</p>
      </div>
      <div>
        <p class="text-[8px] font-bold text-slate-400 uppercase tracking-widest mb-1">Carrier</p>
        <p class="text-[10px] font-semibold text-slate-800"><span data-highlight="carrier">Sample Freight Lines</span></p>
        <p class="text-[9px] text-slate-400 mt-1">Waybill:&nbsp;<span data-highlight="waybill" class="font-mono font-bold text-slate-800">LR-2026-05521</span></p>
      </div>
    </div>
    <!-- Items -->
    <div class="flex-1 mb-2">
      <div class="grid grid-cols-12 text-[8px] font-bold text-slate-400 uppercase tracking-wider pb-1 border-b border-slate-200">
        <div class="col-span-6">Description</div>
        <div class="col-span-3 text-center">Qty</div>
        <div class="col-span-3 text-right">Weight</div>
      </div>
      <div class="grid grid-cols-12 items-center py-1.5 text-[10px] border-b border-slate-50">
        <div class="col-span-6 font-medium text-slate-800"><span data-highlight="item-1">Galvanised steel sheet — 2 mm</span></div>
        <div class="col-span-3 text-center text-slate-500"><span data-highlight="qty-1">24 Sheets</span></div>
        <div class="col-span-3 text-right font-mono text-slate-600">120 kg</div>
      </div>
      <div class="grid grid-cols-12 items-center py-1.5 text-[10px] border-b border-slate-50">
        <div class="col-span-6 font-medium text-slate-700">Packing material</div>
        <div class="col-span-3 text-center text-slate-400">3 Bundles</div>
        <div class="col-span-3 text-right text-slate-400">—</div>
      </div>
    </div>
    <!-- Summary -->
    <div class="border-t border-slate-200 pt-2 space-y-1">
      <div class="flex justify-between text-[10px] text-slate-500">
        <span>Total Packages</span><span class="font-mono font-bold text-slate-800"><span data-highlight="total">3 Bundles</span></span>
      </div>
      <div class="flex justify-between text-[10px] text-slate-500">
        <span>Gross Weight</span><span class="font-mono">~120 kg</span>
      </div>
      <div class="flex justify-between text-[10px] font-bold text-slate-800 border-t border-slate-100 pt-1">
        <span>Against Invoice</span><span class="font-mono">INV-2026-1847</span>
      </div>
    </div>
    <p class="text-[8px] text-slate-300 text-center mt-3 pt-2 border-t border-dashed border-slate-100">This document must accompany the goods</p>
  </div>
</div>

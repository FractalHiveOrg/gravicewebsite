---
// InvoiceDoc.astro - HTML replica of Invoice paper document
---

<!-- ── INVOICE DOCUMENT NODE ── -->
<div
  id="int-input-layer-invoice"
  class="int-input-layer absolute inset-0 w-full h-full z-10 opacity-0 bg-white overflow-hidden"
  data-doc="invoice"
>
  <div class="p-4 sm:p-5 h-full flex flex-col font-sans text-slate-700 text-[10px] leading-snug">
    <!-- Header -->
    <div class="flex justify-between items-start mb-3 pb-2.5 border-b-2 border-slate-900">
      <div>
        <p class="text-[11px] font-black text-slate-900 uppercase tracking-tight">Acme Metals Ltd.</p>
        <p class="text-[9px] text-slate-400 mt-0.5">123 Industrial Estate, Mumbai — 400 001</p>
        <p class="text-[9px] text-slate-500 mt-1.5">GSTIN&nbsp;<span data-highlight="gstin" class="font-mono font-bold text-slate-800">GST12345678IN90</span></p>
      </div>
      <div class="text-right">
        <p class="text-[20px] font-black text-slate-900 uppercase leading-none">Invoice</p>
        <p class="text-[9px] text-slate-400 mt-1.5">No.&nbsp;<span data-highlight="invoice-no" class="font-bold font-mono text-slate-800">INV-2026-1847</span></p>
        <p class="text-[9px] text-slate-400 mt-0.5">Date:&nbsp;<span data-highlight="date" class="font-semibold text-slate-700">8 Sep 2026</span></p>
      </div>
    </div>
    <!-- Bill To -->
    <div class="mb-3">
      <p class="text-[8px] font-bold text-slate-400 uppercase tracking-widest mb-1">Bill To</p>
      <p class="text-[10px] font-bold text-slate-800"><span data-highlight="supplier">Sample Customer Pvt. Ltd.</span></p>
      <p class="text-[9px] text-slate-400">456 Business Park, New Delhi — 110 001</p>
    </div>
    <!-- Items -->
    <div class="flex-1 mb-2">
      <div class="grid grid-cols-12 text-[8px] font-bold text-slate-400 uppercase tracking-wider pb-1 border-b border-slate-200">
        <div class="col-span-6">Description</div>
        <div class="col-span-2 text-center">Qty</div>
        <div class="col-span-4 text-right">Amount</div>
      </div>
      <div class="grid grid-cols-12 items-center py-1.5 text-[10px] border-b border-slate-50">
        <div class="col-span-6 font-medium text-slate-800"><span data-highlight="item-1">Galvanised steel sheet — 2 mm</span></div>
        <div class="col-span-2 text-center text-slate-500"><span data-highlight="qty-1">24</span></div>
        <div class="col-span-4 text-right font-mono font-semibold text-slate-800"><span data-highlight="amount-1">₹22,400.16</span></div>
      </div>
      <div class="grid grid-cols-12 items-center py-1.5 text-[10px] border-b border-slate-50">
        <div class="col-span-6 font-medium text-slate-700">Cutting and handling</div>
        <div class="col-span-2 text-center text-slate-400">1</div>
        <div class="col-span-4 text-right font-mono text-slate-700">₹1,897.32</div>
      </div>
    </div>
    <!-- Totals -->
    <div class="border-t border-slate-200 pt-2 space-y-1">
      <div class="flex justify-between text-[10px] text-slate-500">
        <span>Subtotal</span><span class="font-mono"><span data-highlight="subtotal">₹24,297.48</span></span>
      </div>
      <div class="flex justify-between text-[10px] text-slate-400">
        <span>GST @ 18%</span><span class="font-mono">₹4,500.00</span>
      </div>
      <div class="flex justify-between text-[11px] font-black text-slate-900 border-t border-slate-900 pt-1.5 mt-0.5">
        <span>TOTAL</span><span class="font-mono"><span data-highlight="total">₹28,797.48</span></span>
      </div>
    </div>
    <p class="text-[8px] text-slate-300 text-center mt-3 pt-2 border-t border-dashed border-slate-100">Computer generated — no signature required</p>
  </div>
</div>

---
// ReceiptDoc.astro - HTML replica of Receipt paper document
---

<!-- ── RECEIPT DOCUMENT NODE ── -->
<div
  id="int-input-layer-receipt"
  class="int-input-layer absolute inset-0 w-full h-full z-10 opacity-0 bg-white overflow-hidden"
  data-doc="receipt"
>
  <div class="p-4 sm:p-5 h-full flex flex-col font-sans text-slate-700 text-[10px] leading-snug">
    <!-- Header -->
    <div class="flex justify-between items-start mb-3 pb-2.5 border-b-2 border-slate-900">
      <div>
        <p class="text-[11px] font-black text-slate-900 uppercase tracking-tight">Acme Metals Ltd.</p>
        <p class="text-[9px] text-slate-400 mt-0.5">123 Industrial Estate, Mumbai — 400 001</p>
      </div>
      <div class="text-right">
        <p class="text-[20px] font-black text-slate-900 uppercase leading-none">Receipt</p>
        <p class="text-[9px] text-slate-400 mt-1.5">No.&nbsp;<span data-highlight="receipt-no" class="font-bold font-mono text-slate-800">RCT-2026-1847</span></p>
        <p class="text-[9px] text-slate-400 mt-0.5">Date:&nbsp;<span data-highlight="date" class="font-semibold text-slate-700">15 Sep 2026</span></p>
      </div>
    </div>
    <!-- Received From -->
    <div class="mb-3">
      <p class="text-[8px] font-bold text-slate-400 uppercase tracking-widest mb-1">Received From</p>
      <p class="text-[10px] font-bold text-slate-800"><span data-highlight="supplier">Sample Customer Pvt. Ltd.</span></p>
      <p class="text-[9px] text-slate-400">456 Business Park, New Delhi — 110 001</p>
    </div>
    <!-- Payment Details -->
    <div class="bg-slate-50 border border-slate-100 rounded-xl p-3 mb-3 space-y-2">
      <p class="text-[8px] font-bold text-slate-400 uppercase tracking-widest mb-1">Payment Details</p>
      <div class="flex justify-between"><span class="text-slate-400">Mode</span><span class="font-semibold text-slate-800">NEFT</span></div>
      <div class="flex justify-between"><span class="text-slate-400">Txn Reference</span><span class="font-mono font-bold text-slate-800"><span data-highlight="txn-ref">4821903356</span></span></div>
      <div class="flex justify-between"><span class="text-slate-400">Bank</span><span class="font-semibold text-slate-800">HDFC Bank NA</span></div>
      <div class="flex justify-between"><span class="text-slate-400">Against Invoice</span><span class="font-mono font-semibold text-slate-800">INV-2026-1847</span></div>
    </div>
    <!-- Amount -->
    <div class="border-t border-slate-900 pt-3 mt-auto">
      <div class="flex justify-between items-center">
        <div>
          <p class="text-[9px] text-slate-400 uppercase tracking-wider">Amount Received</p>
          <p class="text-[8px] text-slate-300 mt-0.5">in full settlement</p>
        </div>
        <p class="text-[20px] font-black text-slate-900 font-mono"><span data-highlight="total">₹28,797.48</span></p>
      </div>
      <div class="mt-2 bg-emerald-50 border border-emerald-200 rounded-lg px-3 py-1.5 flex items-center gap-2">
        <svg class="w-3 h-3 text-emerald-600 shrink-0" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25"/><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="text-[9px] font-bold text-emerald-800 uppercase tracking-wide">Payment Received in Full</span>
      </div>
    </div>
    <p class="text-[8px] text-slate-300 text-center mt-3 pt-2 border-t border-dashed border-slate-100">Official receipt — retain for records</p>
  </div>
</div>

---
// SourceConnectors.astro - 3 Cloud Source Cards (Google Drive, OneDrive, Dropbox) with converging dashed connectors
import { Image } from "astro:assets";
import googleDriveLogo from "../../assets/logos/a6802a9d825daefb7bcd7757408d1f1ed63ddf04.png";
import oneDriveLogo from "../../assets/logos/577f7e88e3b153252531db94c82633f830c68e86.png";
import dropboxLogo from "../../assets/logos/4590dd51b023f445bb89081097dd62e854d30714.png";
---

<div class="flex items-center shrink-0 z-10">
  <!-- ========== 3 SOURCE CARDS (Google Drive, OneDrive, Dropbox) ========== -->
  <div class="relative h-[480px] w-20 sm:w-24 md:w-26 shrink-0 z-10">
    <!-- Card 1: Google Drive (Top - aligns with y=120) -->
    <div class="absolute top-[120px] -translate-y-1/2 left-0 right-0 flex items-center justify-center">
      <div
        id="source-card-1"
        class="w-20 h-20 sm:w-24 sm:h-24 md:w-26 md:h-26 bg-white rounded-2xl sm:rounded-3xl border border-slate-200/80 shadow-[0_8px_30px_rgba(0,0,0,0.06)] flex items-center justify-center p-3.5 sm:p-4 hover:scale-105 hover:shadow-[0_12px_36px_rgba(0,0,0,0.09)] transition-all duration-300"
      >
        <Image
          src={googleDriveLogo}
          alt="Google Drive"
          width={110}
          height={110}
          class="w-10 h-10 sm:w-12 sm:h-12 md:w-13 md:h-13 object-contain select-none pointer-events-none"
          loading="eager"
        />
      </div>
    </div>

    <!-- Card 2: OneDrive (Middle - aligns with y=240) -->
    <div class="absolute top-[240px] -translate-y-1/2 left-0 right-0 flex items-center justify-center">
      <div
        id="source-card-2"
        class="w-20 h-20 sm:w-24 sm:h-24 md:w-26 md:h-26 bg-white rounded-2xl sm:rounded-3xl border border-slate-200/80 shadow-[0_8px_30px_rgba(0,0,0,0.06)] flex items-center justify-center p-3.5 sm:p-4 hover:scale-105 hover:shadow-[0_12px_36px_rgba(0,0,0,0.09)] transition-all duration-300"
      >
        <Image
          src={oneDriveLogo}
          alt="Microsoft OneDrive"
          width={130}
          height={90}
          class="w-11 sm:w-13 md:w-14 h-auto object-contain select-none pointer-events-none"
          loading="eager"
        />
      </div>
    </div>

    <!-- Card 3: Dropbox (Bottom - aligns with y=360) -->
    <div class="absolute top-[360px] -translate-y-1/2 left-0 right-0 flex items-center justify-center">
      <div
        id="source-card-3"
        class="w-20 h-20 sm:w-24 sm:h-24 md:w-26 md:h-26 bg-white rounded-2xl sm:rounded-3xl border border-slate-200/80 shadow-[0_8px_30px_rgba(0,0,0,0.06)] flex items-center justify-center p-3.5 sm:p-4 hover:scale-105 hover:shadow-[0_12px_36px_rgba(0,0,0,0.09)] transition-all duration-300"
      >
        <Image
          src={dropboxLogo}
          alt="Dropbox"
          width={110}
          height={100}
          class="w-10 sm:w-12 md:w-13 h-auto object-contain select-none pointer-events-none"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <!-- ========== CONVERGING DASHED CONNECTORS ========== -->
  <div
    id="left-connectors"
    class="w-16 sm:w-24 md:w-28 lg:w-36 h-120 relative shrink-0"
  >
    <!-- Base Dashed Connecting Tracks -->
    <svg
      class="absolute inset-0 w-full h-full pointer-events-none overflow-visible"
      viewBox="0 0 100 480"
      preserveAspectRatio="none"
      fill="none"
    >
      <!-- Top curved line (from Google Drive) -->
      <path
        d="M 0 120 C 50 120, 65 240, 100 240"
        stroke="#64748B"
        stroke-width="1.5"
        stroke-dasharray="3 3"
      />
      <!-- Middle straight line (from OneDrive) -->
      <path
        d="M 0 240 L 100 240"
        stroke="#64748B"
        stroke-width="1.5"
        stroke-dasharray="3 3"
      />
      <!-- Bottom curved line (from Dropbox) -->
      <path
        d="M 0 360 C 50 360, 65 240, 100 240"
        stroke="#64748B"
        stroke-width="1.5"
        stroke-dasharray="3 3"
      />
    </svg>

    <!-- Animated Live Sticks with Head, Body, Tail -->
    <!-- Track 1: Top Curve (Invoice from Google Drive) -->
    <div
      id="left-stick-1"
      class="absolute inset-0 pointer-events-none"
      style="opacity: 0;"
    >
      <svg
        class="w-full h-full overflow-visible"
        viewBox="0 0 100 480"
        preserveAspectRatio="none"
        fill="none"
      >
        <path
          class="wf-fork-tail"
          d="M 0 120 C 50 120, 65 240, 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="28 200"
          stroke-dashoffset="28"
        />
        <path
          class="wf-fork-body"
          d="M 0 120 C 50 120, 65 240, 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="16 200"
          stroke-dashoffset="16"
        />
        <path
          class="wf-fork-head"
          d="M 0 120 C 50 120, 65 240, 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="8 200"
          stroke-dashoffset="8"
        />
      </svg>
    </div>

    <!-- Track 2: Middle Line (Receipt from OneDrive) -->
    <div
      id="left-stick-2"
      class="absolute inset-0 pointer-events-none"
      style="opacity: 0;"
    >
      <svg
        class="w-full h-full overflow-visible"
        viewBox="0 0 100 480"
        preserveAspectRatio="none"
        fill="none"
      >
        <path
          class="wf-fork-tail"
          d="M 0 240 L 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="28 200"
          stroke-dashoffset="28"
        />
        <path
          class="wf-fork-body"
          d="M 0 240 L 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="16 200"
          stroke-dashoffset="16"
        />
        <path
          class="wf-fork-head"
          d="M 0 240 L 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="8 200"
          stroke-dashoffset="8"
        />
      </svg>
    </div>

    <!-- Track 3: Bottom Curve (Shipping from Dropbox) -->
    <div
      id="left-stick-3"
      class="absolute inset-0 pointer-events-none"
      style="opacity: 0;"
    >
      <svg
        class="w-full h-full overflow-visible"
        viewBox="0 0 100 480"
        preserveAspectRatio="none"
        fill="none"
      >
        <path
          class="wf-fork-tail"
          d="M 0 360 C 50 360, 65 240, 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="28 200"
          stroke-dashoffset="28"
        />
        <path
          class="wf-fork-body"
          d="M 0 360 C 50 360, 65 240, 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="16 200"
          stroke-dashoffset="16"
        />
        <path
          class="wf-fork-head"
          d="M 0 360 C 50 360, 65 240, 100 240"
          pathLength="200"
          stroke="#1E3A5F"
          stroke-linecap="round"
          stroke-dasharray="8 200"
          stroke-dashoffset="8"
        />
      </svg>
    </div>
  </div>
</div>

<style>
  /* Fork Fading Gradient Live Sticks matching WorkflowSection.astro */
  .wf-fork-head {
    stroke-width: 2.5;
    opacity: 1;
    filter: drop-shadow(0 0 2px rgba(30, 58, 95, 0.45));
  }

  .wf-fork-body {
    stroke-width: 2.1;
    opacity: 0.45;
  }

  .wf-fork-tail {
    stroke-width: 1.7;
    opacity: 0.18;
  }
</style>

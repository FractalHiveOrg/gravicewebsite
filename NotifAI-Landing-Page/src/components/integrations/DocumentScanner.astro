---
// DocumentScanner.astro - Center card featuring scanner laser, wipe reveal, and paper document/extracted data states
import InvoiceDoc from "./docs/InvoiceDoc.astro";
import ReceiptDoc from "./docs/ReceiptDoc.astro";
import ShippingDoc from "./docs/ShippingDoc.astro";
import InvoiceOutput from "./outputs/InvoiceOutput.astro";
import ReceiptOutput from "./outputs/ReceiptOutput.astro";
import ShippingOutput from "./outputs/ShippingOutput.astro";
---

<!-- ========== CENTER CARD: DOCUMENT SCANNER ========== -->
<div id="doc-scanner-wrapper" class="z-20 w-[340px] sm:w-[420px] md:w-[460px] shrink-0 relative">
  <!-- ═══════════════════════════════════════════════════════
       FLOATING STATUS PILL (Outside top of center card)
       Matches the pill design with live text & circular spinner
       ═══════════════════════════════════════════════════════ -->
  <div
    id="scanner-status-pill"
    class="absolute -top-11 sm:-top-13 left-1/2 -translate-x-1/2 z-30 pointer-events-none select-none flex items-center gap-2.5 sm:gap-3 bg-white px-4 sm:px-5 py-1.5 sm:py-2 rounded-full border border-slate-200/90 shadow-[0_8px_30px_rgba(0,0,0,0.06)]"
  >
    <span
      id="scanner-status-text"
      class="text-[13px] sm:text-sm font-normal text-slate-700 tracking-tight whitespace-nowrap"
    >
      Pulling invoice
    </span>
    <div class="w-4.5 h-4.5 sm:w-5 sm:h-5 rounded-full bg-primary flex items-center justify-center shrink-0 relative overflow-hidden">
      <!-- Spinning ring track matching uploaded image -->
      <svg
        id="scanner-status-spinner"
        class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-white animate-spin"
        viewBox="0 0 24 24"
        fill="none"
      >
        <circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.8" />
        <path class="opacity-100" fill="currentColor" d="M12 3a9 9 0 0 1 9 9h-2.8a6.2 6.2 0 0 0-6.2-6.2V3z" />
      </svg>
      <!-- Success Checkmark -->
      <svg
        id="scanner-status-check"
        class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-emerald-400 hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20 6 9 17l-5-5" />
      </svg>
    </div>
  </div>

  <div
    id="doc-scanner-card"
    class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-[0_12px_45px_rgba(0,0,0,0.06)] relative overflow-hidden select-none"
    style="height: 480px;"
  >
    <!-- Scanner Laser Line (Step 3: Green laser scan with glow) -->
    <div id="int-laser-line" class="absolute left-0 right-0 z-50 pointer-events-none opacity-0" style="top:0%;">
      <div class="laser-beam-bar w-full"></div>
      <div class="laser-glow-sheen absolute inset-x-0 pointer-events-none"></div>
    </div>

    <!-- Reveal Transition Line (Step 3.5 to 4: Blue scanner wipe, NO glow) -->
    <div id="int-reveal-line" class="absolute left-0 right-0 z-50 pointer-events-none opacity-0" style="top:0%;">
      <div class="reveal-line-bar w-full"></div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         IDLE / INGESTION PROCESSING STATE
         Visible during initial live stick flight before doc appears
         ═══════════════════════════════════════════════════════ -->
    <div
      id="doc-scanner-idle"
      class="absolute inset-0 w-full h-full flex flex-col items-center justify-center p-6 text-center z-0 pointer-events-none select-none bg-slate-50/50"
    >
      <div class="relative flex items-center justify-center mb-3">
        <div class="absolute w-16 h-16 rounded-full bg-slate-200/50 animate-ping opacity-20"></div>
        <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-white border border-slate-200/90 shadow-[0_4px_20px_rgba(0,0,0,0.06)] flex items-center justify-center text-slate-800 relative z-10">
          <!-- Document Ingestion / Pull Icon -->
          <svg
            class="w-6 h-6 sm:w-7 sm:h-7 text-slate-800"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <path d="M12 12v6" />
            <path d="m9 15 3 3 3-3" />
          </svg>
        </div>
      </div>

      <!-- Text Header & Subtitle -->
      <h4 class="text-sm sm:text-base font-bold text-slate-800 tracking-tight">
        Pulling document...
      </h4>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         DOCUMENT NODE LAYERS — HTML paper replicas
         Each span with data-highlight gets color-coded
         by the animation after the laser scan completes.
         ═══════════════════════════════════════════════════════ -->
    <InvoiceDoc />
    <ReceiptDoc />
    <ShippingDoc />

    <!-- ═══════════════════════════════════════════════════════
         EXTRACTED OUTPUT LAYERS (one per doc type)
         Hidden until after scan + highlight step.
         ═══════════════════════════════════════════════════════ -->
    <InvoiceOutput />
    <ReceiptOutput />
    <ShippingOutput />

    <!-- ═══════════════════════════════════════════════════════
         SYNCING TO SYSTEMS STATE (Final Step 5)
         Visible while right live stick travels to destination
         ═══════════════════════════════════════════════════════ -->
    <div
      id="doc-scanner-syncing"
      class="absolute inset-0 w-full h-full flex flex-col items-center justify-center p-6 text-center z-30 opacity-0 pointer-events-none select-none bg-white"
    >
      <div class="relative flex items-center justify-center mb-3">
        <div id="sync-ping-circle" class="absolute w-16 h-16 rounded-full bg-blue-200/50 animate-ping opacity-25"></div>
        <div
          id="sync-icon-box"
          class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white border border-slate-200/90 shadow-[0_4px_20px_rgba(0,0,0,0.06)] flex items-center justify-center relative z-10 transition-all duration-300"
        >
          <!-- Cloud Upload Icon (while syncing) -->
          <svg
            id="sync-icon-upload"
            class="w-6 h-6 sm:w-7 sm:h-7 text-[#1E3A5F] transition-opacity duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
            <path d="M12 12v9" />
            <path d="m8 16 4-4 4 4" />
          </svg>
          <!-- Green Checkmark Icon (when synced) -->
          <svg
            id="sync-icon-check"
            class="w-6 h-6 sm:w-7 sm:h-7 text-emerald-600 hidden transition-opacity duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </div>
      </div>

      <!-- Text State: Syncing -->
      <h4 id="sync-text-syncing" class="text-sm sm:text-base font-bold text-slate-800 tracking-tight">
        Syncing to Systems...
      </h4>

      <!-- Text State: Synced Successfully -->
      <h4 id="sync-text-complete" class="text-sm sm:text-base font-bold text-emerald-600 tracking-tight hidden">
        Synced Successfully!
      </h4>
    </div>
  </div>
</div>

<style>
  /* ── Scanner Card CSS Variables ── */
  #doc-scanner-card {
    --reveal-progress: 0%;
  }

  /* Document layer: cut away from top as reveal line passes */
  :global(.int-input-layer) {
    clip-path: inset(var(--reveal-progress, 0%) 0 0 0);
    will-change: clip-path;
  }

  /* Extracted details layer: revealed from top down behind reveal line */
  :global(.int-output-layer) {
    clip-path: inset(0 0 calc(100% - var(--reveal-progress, 0%)) 0);
    will-change: clip-path;
  }

  /* Laser line (Step 3: Green scan) */
  #int-laser-line {
    top: 0%;
    transform: translateY(-50%);
    will-change: top, opacity;
  }

  .laser-beam-bar {
    height: 3px;
    background: linear-gradient(90deg, #059669 0%, #10B981 20%, #34D399 50%, #10B981 80%, #059669 100%);
    box-shadow: 0 0 8px #10B981, 0 0 16px rgba(52, 211, 153, 0.9), 0 0 28px rgba(16, 185, 129, 0.6);
    border-radius: 9999px;
  }

  .laser-glow-sheen {
    height: 40px;
    top: -18px;
    background: linear-gradient(180deg, rgba(16, 185, 129, 0) 0%, rgba(52, 211, 153, 0.25) 50%, rgba(16, 185, 129, 0) 100%);
  }

  /* Reveal transition line (Different blue color, crisp divider with NO glow) */
  #int-reveal-line {
    top: var(--reveal-progress, 0%);
    transform: translateY(-50%);
    will-change: top, opacity;
  }

  .reveal-line-bar {
    height: 2.5px;
    background: #d8d8d8;
    border-radius: 9999px;
    box-shadow: 0 1px 2px rgba(44, 96, 255, 0.18);
  }

  /* Highlight spans on document nodes — blue text only */
  :global([data-highlight]) {
    transition: color 0.2s ease, font-weight 0.2s ease;
  }

  :global([data-highlight].highlighted) {
    color: #2c60ff;
    font-weight: 700;
  }

  /* Extracted field row flash */
  @keyframes field-highlight-pulse {
    0%   { background-color: rgba(52, 211, 153, 0.22); box-shadow: 0 0 0 1.5px rgba(16,185,129,0.35); }
    45%  { background-color: rgba(52, 211, 153, 0.12); box-shadow: 0 0 0 1px rgba(16,185,129,0.18); }
    100% { background-color: transparent; box-shadow: none; }
  }

  :global([data-field-row].field-row-flash) {
    animation: field-highlight-pulse 0.85s ease-out forwards;
    border-radius: 8px;
  }

  /* Validation state — hidden by default, toggled via JS */
  :global(.val-block .val-verified) {
    display: none;
  }
  :global(.val-block.verified .val-processing) {
    display: none;
  }
  :global(.val-block.verified .val-verified) {
    display: flex;
  }

  /* Smooth Gear Rotation */
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 9s linear infinite;
  }
</style>

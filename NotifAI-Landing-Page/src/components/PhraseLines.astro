---
// PhraseLines.astro - Renders "\n"-separated phrases, breaking between them on sm+ screens
interface Props {
  text: string;
}

const lines = Astro.props.text.split("\n");
---

{lines.map((line, i) => (
  <Fragment>
    {line}
    {i < lines.length - 1 && (
      <Fragment>
        {" "}
        <br class="hidden sm:inline" />
      </Fragment>
    )}
  </Fragment>
))}

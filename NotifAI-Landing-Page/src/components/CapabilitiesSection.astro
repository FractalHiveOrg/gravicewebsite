---
// CapabilitiesSection.astro - Capabilities section for Accounts Payable & workflows
import { Image } from "astro:assets";
import iconInvoiceIntake from "../assets/icons /icon 7.svg";
import iconDocIntelligence from "../assets/icons /icon 6.svg";
import iconValidationMatching from "../assets/icons /icon 5.svg";
import iconApprovalsPosting from "../assets/icons /icon 4.svg";
import PhraseLines from "./PhraseLines.astro";

interface CapabilityItem {
  title: string;
  description: string;
  icon: ImageMetadata;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items?: CapabilityItem[];
}

const defaultItems: CapabilityItem[] = [
  {
    title: "Invoice Intake",
    description: "Email, upload, API or SFTP.\nEvery invoice lands in one queue.",
    icon: iconInvoiceIntake,
  },
  {
    title: "Document Intelligence",
    description: "Vendor, amounts, line items and tax\npulled out and checked.",
    icon: iconDocIntelligence,
  },
  {
    title: "Validation & Matching",
    description: "Matched against POs and GRNs.\nMismatches flagged with the reason.",
    icon: iconValidationMatching,
  },
  {
    title: "Approvals & Posting",
    description: "Approved invoices posted to your ERP\nwith the approval trail attached.",
    icon: iconApprovalsPosting,
  },
];

const {
  eyebrow = "CAPABILITIES",
  title = "Everything after\nthe invoice arrives.",
  items = defaultItems,
} = Astro.props;
---

<section class="w-full px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20 md:pb-24">
  <div class="max-w-7xl mx-auto">
    <!-- Eyebrow -->
    <p class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] text-slate-400 uppercase mb-3 sm:mb-4">
      {eyebrow}
    </p>

    <!-- Main Heading -->
    <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-[46px] font-normal text-slate-900 tracking-tight leading-[1.14] font-capabilities-serif mb-8 sm:mb-10 md:mb-12 text-balance">
      <PhraseLines text={title} />
    </h2>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-5 lg:gap-6 xl:gap-5 items-stretch">
      {items.map((item) => (
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-2xs hover:shadow-sm hover:border-slate-300 transition-all duration-200 p-6 sm:p-7 xl:p-6 flex flex-col justify-between min-h-[220px] sm:min-h-[240px]">
          <!-- Top: Title & Description -->
          <div>
            <h3 class="text-base sm:text-lg md:text-[19px] font-semibold text-slate-900 tracking-tight leading-snug">
              {item.title}
            </h3>
            <p class="text-xs sm:text-[13px] md:text-sm xl:text-[13px] text-slate-600 font-normal leading-relaxed mt-2.5 text-pretty">
              <PhraseLines text={item.description} />
            </p>
          </div>

          <!-- Bottom: Icon Right Aligned -->
          <div class="flex justify-end items-end pt-8 sm:pt-10">
            <Image
              src={item.icon}
              alt={item.title}
              class="w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 object-contain select-none"
              loading="lazy"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .font-capabilities-serif {
    font-family: "Newsreader", "Times New Roman", Times, serif;
    letter-spacing: -0.02em;
  }
</style>

---
// WhyNicoSection.astro - Why Nico Enterprise Capabilities Section
import PhraseLines from "./PhraseLines.astro";

const tabs = [
  {
    id: "complexity",
    title: "Built for enterprise complexity",
    description: "Three systems, two approvals, one exception.\nStill one workflow.",
    gradient:
      "linear-gradient(120.59deg, #05274A -0.35%, #174771 49.83%, #3F608A 74.91%, #747A91 100%)",
    // Set video path here (supports .mp4, .webm)
    video: "https://fractalhiveassets.blob.core.windows.net/assets/ComplexWF-New.mp4?sp=r&st=2026-10-08T05:16:30Z&se=2036-10-07T13:31:30Z&spr=https&sv=2026-02-06&sr=b&sig=NnIZPJIcUYPahl8x99RxO0BGOxno9GsN2qwzvpqnVxI%3D",
    image: "",
  },
  {
    id: "configurable",
    title: "Set up your way",
    description: "Your thresholds, your approvers, your ERP.\nNo fixed template to work around.",
    gradient:
      "linear-gradient(120.59deg, #1D5034 -0.35%, #50787B 49.83%, #669785 74.91%, #81A67D 100%)",
    video: "https://fractalhiveassets.blob.core.windows.net/assets/config-workflow-web.mp4?sp=r&st=2026-10-08T05:17:50Z&se=2036-10-07T13:32:50Z&spr=https&sv=2026-02-06&sr=b&sig=WcxMBtefiIR5zYGk0UlMXx%2FisVfmEyiBR0%2FyF8mWY%2F8%3D",
    image: "",
  },
  {
    id: "humans",
    title: "Your team and Nico",
    description: "Routine use cases are processed directly.\nEdge cases land with the right decision maker.",
    gradient:
      "linear-gradient(120.59deg, #C7796A -0.35%, #D47B5D 49.83%, #D19768 74.91%, #C7A676 100%)",
    video: "https://fractalhiveassets.blob.core.windows.net/assets/NicoHumans-New.mp4?sp=r&st=2026-10-08T05:17:11Z&se=2036-10-07T13:32:11Z&spr=https&sv=2026-02-06&sr=b&sig=r28pMLdJWI4rMqlEqtyJFeOUFlLB%2FeiaDXmbCyr520E%3D",
    image: "",
  },
  {
    id: "control",
    title: "Every step on record",
    description: "See who approved what, and when.",
    gradient:
      "linear-gradient(120.59deg, #14181D -0.35%, #566270 49.83%, #9BA3AD 74.91%, #DDE1E5 100%)",
    video: "https://fractalhiveassets.blob.core.windows.net/assets/Audit-New.mp4?sp=r&st=2026-10-08T05:15:36Z&se=2036-10-07T13:30:36Z&spr=https&sv=2026-02-06&sr=b&sig=2%2Far5%2FbVBL4Bp67oYr0KPkoF9zxougKVVPng50kItyM%3D",
    image: "",
  },
];
---

<section
  id="why-nico-section"
  class="w-full sm:min-h-screen sm:py-20 lg:py-0 px-4 sm:px-6 lg:px-10 flex flex-col items-center justify-center relative overflow-hidden"
>
  <div class="w-full max-w-340 mx-auto flex flex-col justify-center">

    <!-- ================= DESKTOP VIEW (lg:grid) ================= -->
    <div class="hidden lg:grid grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- LEFT COLUMN: CONTENT & TABS -->
      <div class="col-span-5 flex flex-col justify-center">
        <!-- Eyebrow Tag -->
        <p
          class="text-xs sm:text-[13px] font-bold tracking-[0.2em] uppercase text-slate-500 mb-3 select-none"
        >
          WHY NICO
        </p>

        <!-- Main Heading -->
        <div class="w-full max-w-xl">
          <h2
            class="text-3xl sm:text-4xl lg:text-[44px] font-normal text-slate-900 font-why-serif mb-4 leading-tight"
          >
            Built for processes <br class="hidden sm:inline" />
            with exceptions.
          </h2>
          
          <!-- Subtitle -->
         
        </div>

        <!-- Interactive Cards List -->
        <div class="flex flex-col gap-3 sm:gap-3.5 w-full" id="why-nico-tabs" role="tablist">
          {
            tabs.map((tab, idx) => (
              <button
                type="button"
                role="tab"
                id={`why-tab-${tab.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`why-panel-${tab.id}`}
                data-tab-id={tab.id}
                data-tab-index={idx}
                class={`why-tab-btn group text-left w-full rounded-xl sm:rounded-2xl transition-all duration-300 cursor-pointer p-4 sm:p-5 flex flex-col justify-start border [transform:translateZ(0)] [backface-visibility:hidden] ${
                  idx === 0
                    ? "active  border-[#25456C] shadow-[0_2px_12px_rgba(37,69,108,0.08)]"
                    : "bg-white/95 border-slate-200 hover:border-slate-300 hover:bg-white shadow-[0_2px_8px_rgba(0,0,0,0.02)]"
                }`}
              >
                <div class="flex items-center justify-between w-full">
                  <h3 class="text-sm sm:text-[15px] font-semibold text-slate-900 tracking-tight leading-snug group-hover:text-slate-950">
                    {tab.title}
                  </h3>
                </div>
                <p
                  class={`text-xs sm:text-[13px] leading-relaxed mt-1.5 transition-colors duration-200 ${
                    idx === 0 ? "text-slate-700" : "text-slate-500 group-hover:text-slate-600"
                  }`}
                >
                  <PhraseLines text={tab.description} />
                </p>
              </button>
            ))
          }
        </div>
      </div>

      <!-- RIGHT COLUMN: VISUAL CONTAINER (732 Fill × 620 Hug) -->
      <div class="col-span-7 w-full flex justify-center items-end h-full">
        <div
          id="why-nico-visual-card"
          class="relative w-full h-full min-h-[520px] sm:min-h-[580px] lg:min-h-[620px] rounded-2xl sm:rounded-3xl lg:rounded-[28px] overflow-hidden shadow-[0_20px_50px_rgba(10,35,65,0.22)] border border-white/15"
        >
          {
            tabs.map((tab, idx) => (
              <div
                id={`why-panel-${tab.id}`}
                data-panel-id={tab.id}
                data-panel-index={idx}
                class={`why-panel absolute p-5 sm:p-6 lg:p-7 inset-0 w-full h-full flex flex-col items-center justify-center overflow-hidden transition-all duration-300 ${
                  idx === 0
                    ? "opacity-100 z-10"
                    : "opacity-0 z-0 pointer-events-none"
                }`}
                style={`background: ${tab.gradient};`}
              >
                <!-- Subtle Noise Texture Overlay -->
                <div
                  class="absolute inset-0 pointer-events-none select-none z-0 opacity-15"
                  style="background-image: url('/noise.png'); background-repeat: repeat; background-size: 128px 128px;"
                  aria-hidden="true"
                ></div>

                <!-- Ambient soft inner glow -->
                <div
                  class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-white/10 blur-3xl pointer-events-none z-0"
                  aria-hidden="true"
                ></div>

                <!-- ================= CENTER MEDIA CONTAINER (VIDEO / IMAGE) ================= -->
                <div class="relative z-10 w-full h-full flex items-center justify-center p-1 sm:p-2">
                  {tab.video && (
                    <div class="relative w-full h-full flex items-center justify-center">
                      <div class="why-video-loader absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-300 z-20 opacity-0" aria-hidden="true">
                        <div class="w-10 h-10 rounded-full border-3 border-white/20 border-t-white animate-spin"></div>
                      </div>
                      <video
                        data-src={tab.video}
                        src={idx === 0 ? tab.video : undefined}
                        preload={idx === 0 ? "metadata" : "none"}
                        muted
                        playsinline
                        class="why-desktop-video max-w-full max-h-full w-auto h-auto object-contain rounded-xl sm:rounded-2xl shadow-2xl border border-white/20 transition-transform duration-300 hover:scale-[1.01]"
                      />
                    </div>
                  )}
                  {!tab.video && tab.image && (
                    <img
                      src={tab.image}
                      alt={tab.title}
                      class="max-w-full max-h-full object-contain rounded-xl sm:rounded-2xl shadow-2xl transition-transform duration-300 hover:scale-[1.02]"
                    />
                  )}
                  {!tab.video && !tab.image && (
                    <div class="flex flex-col items-center justify-center text-white/90 gap-3">
                      <div class="w-16 h-16 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center shadow-inner">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                      </div>
                      <span class="text-sm font-medium text-white/90 tracking-wide">Total Operational Control</span>
                    </div>
                  )}
                </div>
              </div>
            ))
          }

          <!-- Video Progress Bar at bottom of gradient card -->
          <div
            class="absolute bottom-0 left-0 right-0 h-1 sm:h-1.5 bg-black/25 backdrop-blur-xs z-30 pointer-events-none overflow-hidden"
            aria-hidden="true"
          >
            <div
              id="why-desktop-progress-fill"
              class="h-full bg-white shadow-[0_0_8px_rgba(255,255,255,0.85)] rounded-r-full will-change-[width]"
              style="width: 0%;"
            ></div>
          </div>
        </div>
      </div>

    </div>

    <!-- ================= MOBILE VIEW (lg:hidden) ================= -->
    <div class="block lg:hidden w-full max-w-lg mx-auto py-2">
      <!-- Eyebrow & Header -->
      <div class="mb-6 sm:mb-8 text-left">
        <p class="text-[11px] sm:text-xs font-bold tracking-[0.2em] uppercase text-slate-500 mb-2 select-none">
          WHY NICO
        </p>
        <h2 class="text-3xl sm:text-4xl font-normal text-slate-900 font-why-serif mb-2 leading-tight text-balance">
          Built for processes <br class="hidden sm:inline" />
          with exceptions.
        </h2>
     
      </div>

      <!-- Accordion List -->
      <div class="w-full border-b border-slate-200" id="why-nico-mobile-accordion">
        {
          tabs.map((tab, idx) => (
            <div
              class={`why-accordion-item border-t border-slate-200 transition-colors ${idx === 0 ? "is-open" : ""}`}
              data-accordion-index={idx}
            >
              <button
                type="button"
                class="why-accordion-header group w-full py-4.5 sm:py-5 flex items-center justify-between text-left cursor-pointer focus-visible:outline-2 focus-visible:outline-[#174771] focus-visible:outline-offset-2 select-none"
                aria-expanded={idx === 0 ? "true" : "false"}
                aria-controls={`why-acc-content-${tab.id}`}
                id={`why-acc-header-${tab.id}`}
              >
                <span class="text-base sm:text-lg font-semibold text-slate-900 tracking-tight leading-snug group-hover:text-slate-950 pr-4">
                  {tab.title}
                </span>
                <span class="why-accordion-icon relative flex items-center justify-center w-6 h-6 shrink-0 text-slate-900" aria-hidden="true">
                  <!-- Horizontal line (always visible) -->
                  <span class="absolute w-3.5 h-[2px] bg-slate-900 rounded-full"></span>
                  <!-- Vertical line (hides when open) -->
                  <span class="why-accordion-icon-vert absolute h-3.5 w-[2px] bg-slate-900 rounded-full"></span>
                </span>
              </button>

              <div
                id={`why-acc-content-${tab.id}`}
                role="region"
                aria-labelledby={`why-acc-header-${tab.id}`}
                class="why-accordion-body"
              >
                <div class="why-accordion-content">
                  <div class="pb-6 pt-1">
                    <!-- Visual Container (Video / Image / Fallback) -->
                    <div
                      class="w-full aspect-16/10 sm:aspect-video rounded-2xl overflow-hidden shadow-[0_12px_36px_rgba(10,35,65,0.18)] border border-white/20 relative flex items-center justify-center p-3 sm:p-4 shrink-0"
                      style={`background: ${tab.gradient};`}
                    >
                      <!-- Noise Texture Overlay -->
                      <div
                        class="absolute inset-0 pointer-events-none select-none z-0 opacity-15"
                        style="background-image: url('/noise.png'); background-repeat: repeat; background-size: 128px 128px;"
                        aria-hidden="true"
                      ></div>

                      <!-- Ambient glow -->
                      <div
                        class="absolute -top-12 -right-12 w-48 h-48 rounded-full bg-white/10 blur-2xl pointer-events-none z-0"
                        aria-hidden="true"
                      ></div>

                      <!-- Video / Image / Fallback -->
                      <div class="relative z-10 w-full h-full flex items-center justify-center">
                        {tab.video && (
                          <div class="relative w-full h-full flex items-center justify-center">
                            <div class="why-video-loader absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-300 z-20 opacity-0" aria-hidden="true">
                              <div class="w-8 h-8 rounded-full border-2.5 border-white/20 border-t-white animate-spin"></div>
                            </div>
                            <video
                              data-src={tab.video}
                              src={idx === 0 ? tab.video : undefined}
                              preload={idx === 0 ? "metadata" : "none"}
                              muted
                              playsinline
                              class="why-mobile-video max-w-full max-h-full w-auto h-auto object-contain rounded-xl shadow-xl border border-white/20"
                            />
                          </div>
                        )}
                        {!tab.video && tab.image && (
                          <img
                            src={tab.image}
                            alt={tab.title}
                            class="max-w-full max-h-full object-contain rounded-xl shadow-xl"
                          />
                        )}
                        {!tab.video && !tab.image && (
                          <div class="flex flex-col items-center justify-center text-white/90 gap-2">
                            <div class="w-12 h-12 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center shadow-inner">
                              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                              </svg>
                            </div>
                            <span class="text-xs font-medium text-white/80">Total Operational Control</span>
                          </div>
                        )}
                      </div>

                      <!-- Video Progress Bar at bottom of mobile gradient card -->
                      <div
                        class="absolute bottom-0 left-0 right-0 h-1 bg-black/25 backdrop-blur-xs z-30 pointer-events-none overflow-hidden"
                        aria-hidden="true"
                      >
                        <div
                          class="why-mobile-progress-fill h-full bg-white shadow-[0_0_6px_rgba(255,255,255,0.85)] rounded-r-full will-change-[width]"
                          style="width: 0%;"
                        ></div>
                      </div>
                    </div>

                    <!-- Description beneath video -->
                    <p class="text-sm sm:text-[15px] text-slate-600 leading-relaxed font-normal mt-4">
                      <PhraseLines text={tab.description} />
                    </p>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

  </div>
</section>

<style>
  .font-why-serif {
    font-family: "Newsreader", "Times New Roman", Georgia, serif;
    letter-spacing: -0.02em;
  }

  /* Tab button styles */
  .why-tab-btn {
    color: inherit !important;
    font-weight: normal !important;
    padding: 16px 20px !important;
    outline: none !important;
  }

  .why-tab-btn.active {
    background-color:rgba(255, 255, 255, 0.95) !important;
    border-color: #25456C !important;
    box-shadow: 0 2px 12px rgba(37, 69, 108, 0.08) !important;
  }

  .why-tab-btn:not(.active) {
    background-color: rgba(255, 255, 255, 0.95) !important;
    border-color: #E2E8F0 !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02) !important;
  }

  .why-tab-btn:not(.active):hover {
    background-color: #ffffff !important;
    border-color: #CBD5E1 !important;
  }

  /* Reset standard button styles for mobile accordion header */
  .why-accordion-header {
    background-color: transparent !important;
    color: inherit !important;
    font-weight: inherit !important;
    padding: 18px 0 !important;
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
  }

  /* Mobile Accordion Smooth Expand/Collapse */
  .why-accordion-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .why-accordion-item.is-open .why-accordion-body {
    grid-template-rows: 1fr;
  }

  .why-accordion-content {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .why-accordion-item.is-open .why-accordion-content {
    opacity: 1;
    transform: translateY(0);
  }

  /* Plus to Minus icon transition */
  .why-accordion-icon {
    pointer-events: none;
  }

  .why-accordion-icon-vert {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
    transform-origin: center center;
  }

  .why-accordion-item.is-open .why-accordion-icon-vert {
    transform: rotate(90deg) scale(0);
    opacity: 0;
  }

  /* Video & layer hardware compositing */
  .why-desktop-video,
  .why-mobile-video {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* Avoid fractional subpixel scaling blur on active panel */
  .why-panel.opacity-100 {
    transform: none !important;
  }

  /* Video Progress Bar fill transition */
  #why-desktop-progress-fill,
  .why-mobile-progress-fill {
    transition: width 0.08s linear;
  }
</style>

<script>
  let whySectionObserver: IntersectionObserver | null = null;
  let whyResizeHandler: (() => void) | null = null;

  function safePlayVideo(video: HTMLVideoElement | null | undefined) {
    if (!video) return;
    try {
      ensureVideoLoaded(video);
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {});
      }
    } catch {
      // Ignore playback restrictions / errors safely
    }
  }

  function safePauseVideo(video: HTMLVideoElement | null | undefined) {
    if (!video) return;
    try {
      if (!video.paused) {
        video.pause();
      }
    } catch {
      // Ignore
    }
  }

  function showVideoLoader(video: HTMLVideoElement | null | undefined) {
    if (!video) return;
    const loader = video.parentElement?.querySelector<HTMLElement>(".why-video-loader");
    if (loader) {
      loader.classList.remove("opacity-0");
      loader.classList.add("opacity-100");
    }
  }

  function hideVideoLoader(video: HTMLVideoElement | null | undefined) {
    if (!video) return;
    const loader = video.parentElement?.querySelector<HTMLElement>(".why-video-loader");
    if (loader) {
      loader.classList.remove("opacity-100");
      loader.classList.add("opacity-0");
    }
  }

  function ensureVideoLoaded(video: HTMLVideoElement | null | undefined) {
    if (!video) return;
    if (!video.getAttribute("src") && video.dataset.src) {
      showVideoLoader(video);
      video.src = video.dataset.src;
      video.preload = "auto";
      video.load();
    }
  }

  function resetAndPlay(video: HTMLVideoElement | null | undefined) {
    if (!video) return;
    ensureVideoLoaded(video);
    if (video.readyState < 3) {
      showVideoLoader(video);
    }
    try {
      if (video.readyState >= 1) {
        video.currentTime = 0;
      } else {
        video.onloadedmetadata = () => {
          video.currentTime = 0;
        };
      }
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {});
      }
    } catch {}
  }

  function setupWhyNico() {
    const section = document.getElementById("why-nico-section");
    if (!section) return;

    const desktopTabs = Array.from(
      section.querySelectorAll<HTMLButtonElement>(".why-tab-btn")
    );
    const desktopPanels = Array.from(
      section.querySelectorAll<HTMLElement>(".why-panel")
    );
    const mobileItems = Array.from(
      section.querySelectorAll<HTMLElement>(".why-accordion-item")
    );
    const visualCard = document.getElementById("why-nico-visual-card");

    const totalCount = Math.max(desktopTabs.length, mobileItems.length);
    if (totalCount === 0) return;

    let currentIndex = 0;
    const initialRect = section.getBoundingClientRect();
    let isSectionVisible = initialRect.top < window.innerHeight && initialRect.bottom > 0;
    let progressAnimId: number | null = null;
    const desktopProgressFill = document.getElementById("why-desktop-progress-fill");

    function isDesktop(): boolean {
      return window.innerWidth >= 1024;
    }

    function setProgressBar(pct: number) {
      const clamped = Math.min(100, Math.max(0, pct));
      if (desktopProgressFill) {
        desktopProgressFill.style.width = `${clamped}%`;
      }
      mobileItems.forEach((item, idx) => {
        const fill = item.querySelector<HTMLElement>(".why-mobile-progress-fill");
        if (fill) {
          fill.style.width = idx === currentIndex ? `${clamped}%` : "0%";
        }
      });
    }

    function updateProgressLoop() {
      const isDesk = isDesktop();
      const activeVid = isDesk
        ? desktopPanels[currentIndex]?.querySelector<HTMLVideoElement>("video")
        : mobileItems[currentIndex]?.querySelector<HTMLVideoElement>("video");

      if (activeVid && activeVid.duration && !isNaN(activeVid.duration) && activeVid.duration > 0) {
        const pct = (activeVid.currentTime / activeVid.duration) * 100;
        setProgressBar(pct);
      }

      if (activeVid && !activeVid.paused && !activeVid.ended) {
        progressAnimId = requestAnimationFrame(updateProgressLoop);
      } else {
        progressAnimId = null;
      }
    }

    function startProgress() {
      if (progressAnimId) {
        cancelAnimationFrame(progressAnimId);
      }
      progressAnimId = requestAnimationFrame(updateProgressLoop);
    }

    function stopProgress() {
      if (progressAnimId) {
        cancelAnimationFrame(progressAnimId);
        progressAnimId = null;
      }
    }

    function preloadNextVideo(nextIdx: number) {
      const dVid = desktopPanels[nextIdx]?.querySelector<HTMLVideoElement>("video");
      ensureVideoLoaded(dVid);
      const mVid = mobileItems[nextIdx]?.querySelector<HTMLVideoElement>("video");
      ensureVideoLoaded(mVid);
    }

    function switchTab(newIndex: number, replay: boolean = true) {
      currentIndex = ((newIndex % totalCount) + totalCount) % totalCount;
      const isDesk = isDesktop();

      setProgressBar(0);

      // 1. Update Desktop Tabs
      desktopTabs.forEach((tab, idx) => {
        const isActive = idx === currentIndex;
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
        const p = tab.querySelector("p");

        if (isActive) {
          tab.classList.add(
            "active",
            "border-[#25456C]",
            "shadow-[0_2px_12px_rgba(37,69,108,0.08)]"
          );
          tab.classList.remove(
            "bg-white/95",
            "border-slate-200",
            "hover:border-slate-300",
            "hover:bg-white",
            "shadow-[0_2px_8px_rgba(0,0,0,0.02)]"
          );
          if (p) {
            p.classList.add("text-slate-700");
            p.classList.remove("text-slate-500");
          }
        } else {
          tab.classList.remove(
            "active",
            "border-[#25456C]",
            "shadow-[0_2px_12px_rgba(37,69,108,0.08)]"
          );
          tab.classList.add(
            "bg-white/95",
            "border-slate-200",
            "hover:border-slate-300",
            "hover:bg-white",
            "shadow-[0_2px_8px_rgba(0,0,0,0.02)]"
          );
          if (p) {
            p.classList.remove("text-slate-700");
            p.classList.add("text-slate-500");
          }
        }
      });

      // 2. Update Desktop Panels
      desktopPanels.forEach((panel, idx) => {
        const isActive = idx === currentIndex;
        const vid = panel.querySelector<HTMLVideoElement>("video");

        if (isActive) {
          panel.classList.add("opacity-100", "z-10");
          panel.classList.remove("opacity-0", "z-0", "pointer-events-none");

          if (isDesk && vid) {
            if (replay) {
              resetAndPlay(vid);
            } else if (isSectionVisible) {
              safePlayVideo(vid);
            }
          }
        } else {
          panel.classList.remove("opacity-100", "z-10");
          panel.classList.add("opacity-0", "z-0", "pointer-events-none");
          safePauseVideo(vid);
        }
      });

      // 3. Update Mobile Accordion
      mobileItems.forEach((item, idx) => {
        const isActive = idx === currentIndex;
        const header = item.querySelector<HTMLButtonElement>(".why-accordion-header");
        const vid = item.querySelector<HTMLVideoElement>("video");

        if (isActive) {
          item.classList.add("is-open");
          header?.setAttribute("aria-expanded", "true");

          if (!isDesk && vid) {
            if (replay) {
              resetAndPlay(vid);
            } else if (isSectionVisible) {
              safePlayVideo(vid);
            }
          }
        } else {
          item.classList.remove("is-open");
          header?.setAttribute("aria-expanded", "false");
          safePauseVideo(vid);
        }
      });

      // Preload next upcoming video in background for seamless loop/transition
      preloadNextVideo((currentIndex + 1) % totalCount);
    }

    // Attach Video Listeners to All Desktop Videos -> auto advance, progress, and loader
    desktopPanels.forEach((panel, idx) => {
      const vid = panel.querySelector<HTMLVideoElement>("video");
      if (vid) {
        vid.addEventListener("waiting", () => showVideoLoader(vid));
        vid.addEventListener("loadstart", () => {
          if (vid.readyState < 3) showVideoLoader(vid);
        });
        vid.addEventListener("canplay", () => hideVideoLoader(vid));
        vid.addEventListener("playing", () => hideVideoLoader(vid));
        vid.addEventListener("loadeddata", () => {
          if (vid.readyState >= 3) hideVideoLoader(vid);
        });

        vid.onplay = () => {
          hideVideoLoader(vid);
          if (isDesktop() && idx === currentIndex) {
            startProgress();
          }
        };
        vid.onpause = () => {
          if (isDesktop() && idx === currentIndex) {
            stopProgress();
          }
        };
        vid.ontimeupdate = () => {
          if (isDesktop() && idx === currentIndex && vid.duration && !isNaN(vid.duration) && vid.duration > 0) {
            setProgressBar((vid.currentTime / vid.duration) * 100);
          }
        };
        vid.onended = () => {
          if (isDesktop() && idx === currentIndex) {
            setProgressBar(100);
            stopProgress();
            switchTab((currentIndex + 1) % totalCount, true);
          }
        };
      }
    });

    // Attach Video Listeners to All Mobile Videos -> auto advance, progress, and loader
    mobileItems.forEach((item, idx) => {
      const vid = item.querySelector<HTMLVideoElement>("video");
      if (vid) {
        vid.addEventListener("waiting", () => showVideoLoader(vid));
        vid.addEventListener("loadstart", () => {
          if (vid.readyState < 3) showVideoLoader(vid);
        });
        vid.addEventListener("canplay", () => hideVideoLoader(vid));
        vid.addEventListener("playing", () => hideVideoLoader(vid));
        vid.addEventListener("loadeddata", () => {
          if (vid.readyState >= 3) hideVideoLoader(vid);
        });

        vid.onplay = () => {
          hideVideoLoader(vid);
          if (!isDesktop() && idx === currentIndex) {
            startProgress();
          }
        };
        vid.onpause = () => {
          if (!isDesktop() && idx === currentIndex) {
            stopProgress();
          }
        };
        vid.ontimeupdate = () => {
          if (!isDesktop() && idx === currentIndex && vid.duration && !isNaN(vid.duration) && vid.duration > 0) {
            setProgressBar((vid.currentTime / vid.duration) * 100);
          }
        };
        vid.onended = () => {
          if (!isDesktop() && idx === currentIndex) {
            setProgressBar(100);
            stopProgress();
            switchTab((currentIndex + 1) % totalCount, true);
          }
        };
      }
    });

    // Desktop Tab Click Handlers
    desktopTabs.forEach((tab, idx) => {
      tab.onclick = (e) => {
        e.preventDefault();
        isSectionVisible = true;
        setProgressBar(0);
        if (idx === currentIndex) {
          // Replay active video from beginning
          const activeVid = desktopPanels[currentIndex]?.querySelector<HTMLVideoElement>("video");
          resetAndPlay(activeVid);
        } else {
          // Switch to clicked tab and play from start
          switchTab(idx, true);
        }
      };
    });

    // Desktop Visual Card click -> also replay active video
    if (visualCard) {
      visualCard.onclick = () => {
        setProgressBar(0);
        const activeVid = desktopPanels[currentIndex]?.querySelector<HTMLVideoElement>("video");
        resetAndPlay(activeVid);
      };
    }

    // Mobile Accordion Header Click Handlers
    mobileItems.forEach((item, idx) => {
      const header = item.querySelector<HTMLButtonElement>(".why-accordion-header");
      if (!header) return;

      header.onclick = (e) => {
        e.preventDefault();
        isSectionVisible = true;
        setProgressBar(0);
        const isOpen = item.classList.contains("is-open");
        const vid = item.querySelector<HTMLVideoElement>("video");

        if (isOpen && idx === currentIndex) {
          // Replay active video again from beginning
          resetAndPlay(vid);
        } else {
          // Open this tab and play from beginning
          switchTab(idx, true);
        }
      };
    });

    // IntersectionObserver to pause/play based on section visibility
    if (whySectionObserver) {
      whySectionObserver.disconnect();
      whySectionObserver = null;
    }

    whySectionObserver = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;
        isSectionVisible = entry.isIntersecting;

        if (isSectionVisible) {
          const isDesk = isDesktop();
          const activeVid = isDesk
            ? desktopPanels[currentIndex]?.querySelector<HTMLVideoElement>("video")
            : mobileItems[currentIndex]?.querySelector<HTMLVideoElement>("video");
          safePlayVideo(activeVid);
          startProgress();
        } else {
          stopProgress();
          section.querySelectorAll<HTMLVideoElement>("video").forEach((v) => {
            safePauseVideo(v);
          });
        }
      },
      { rootMargin: "150px 0px" }
    );
    whySectionObserver.observe(section);

    // Window resize handler: seamlessly adapt between desktop and mobile views
    if (whyResizeHandler) {
      window.removeEventListener("resize", whyResizeHandler);
      whyResizeHandler = null;
    }

    let lastIsDesk = isDesktop();
    whyResizeHandler = () => {
      const currentIsDesk = isDesktop();
      if (currentIsDesk !== lastIsDesk) {
        lastIsDesk = currentIsDesk;
        switchTab(currentIndex, false);
      }
    };
    window.addEventListener("resize", whyResizeHandler);

    // Initialize with tab 0 active
    switchTab(0, false);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupWhyNico, { once: true });
  } else {
    setupWhyNico();
  }

  document.addEventListener("astro:page-load", setupWhyNico);
</script>
